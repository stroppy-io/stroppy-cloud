{
  "id":  {
    "namespace":  "provider",
    "name":  "aws.settings",
    "version":  "v1.0.0"
  },
  "description":  "AWS placement settings of a tenant provider profile (no secrets).",
  "fields":  [
    {
      "name":  "region",
      "description":  "AWS commercial region the run is created in; opt-in regions must be enabled on the account.",
      "required":  true,
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "us-east-1"
            },
            "label":  "us-east-1"
          },
          {
            "value":  {
              "stringValue":  "us-east-2"
            },
            "label":  "us-east-2"
          },
          {
            "value":  {
              "stringValue":  "us-west-1"
            },
            "label":  "us-west-1"
          },
          {
