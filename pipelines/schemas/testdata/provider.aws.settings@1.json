            "label":  "ap-east-1"
          },
          {
            "value":  {
              "stringValue":  "ap-east-2"
            },
            "label":  "ap-east-2"
          },
          {
            "value":  {
              "stringValue":  "ap-south-1"
            },
            "label":  "ap-south-1"
          },
          {
            "value":  {
              "stringValue":  "ap-south-2"
            },
            "label":  "ap-south-2"
          },
          {
            "value":  {
              "stringValue":  "ap-northeast-1"
            },
            "label":  "ap-northeast-1"
          },
          {
            "value":  {
              "stringValue":  "ap-northeast-2"
            },
            "label":  "ap-northeast-2"
          },
          {
            "value":  {
              "stringValue":  "ap-northeast-3"
            },
            "label":  "ap-northeast-3"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-1"
            },
            "label":  "ap-southeast-1"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-2"
            },
            "label":  "ap-southeast-2"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-3"
            },
            "label":  "ap-southeast-3"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-4"
            },
            "label":  "ap-southeast-4"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-5"
            },
            "label":  "ap-southeast-5"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-6"
            },
            "label":  "ap-southeast-6"
          },
          {
            "value":  {
              "stringValue":  "ap-southeast-7"
            },
            "label":  "ap-southeast-7"
          },
          {
            "value":  {
              "stringValue":  "ca-central-1"
            },
            "label":  "ca-central-1"
          },
          {
            "value":  {
              "stringValue":  "ca-west-1"
            },
            "label":  "ca-west-1"
          },
          {
            "value":  {
              "stringValue":  "eu-central-1"
            },
            "label":  "eu-central-1"
          },
          {
            "value":  {
              "stringValue":  "eu-central-2"
            },
            "label":  "eu-central-2"
          },
          {
            "value":  {
              "stringValue":  "eu-west-1"
            },
            "label":  "eu-west-1"
          },
          {
            "value":  {
              "stringValue":  "eu-west-2"
            },
            "label":  "eu-west-2"
          },
          {
            "value":  {
              "stringValue":  "eu-west-3"
            },
            "label":  "eu-west-3"
          },
          {
            "value":  {
              "stringValue":  "eu-north-1"
            },
            "label":  "eu-north-1"
          },
          {
            "value":  {
              "stringValue":  "eu-south-1"
            },
            "label":  "eu-south-1"
          },
          {
            "value":  {
              "stringValue":  "eu-south-2"
            },
            "label":  "eu-south-2"
          },
          {
            "value":  {
              "stringValue":  "il-central-1"
            },
            "label":  "il-central-1"
          },
          {
            "value":  {
              "stringValue":  "mx-central-1"
            },
            "label":  "mx-central-1"
          },
          {
            "value":  {
              "stringValue":  "me-south-1"
            },
            "label":  "me-south-1"
          },
          {
            "value":  {
              "stringValue":  "me-central-1"
            },
            "label":  "me-central-1"
          },
          {
            "value":  {
              "stringValue":  "sa-east-1"
            },
            "label":  "sa-east-1"
          }
        ],
        "default":  {
          "stringValue":  "eu-central-1"
        }
      },
      "group":  "Placement",
      "title":  "Region"
    },
    {
      "name":  "availability_zone",
      "description":  "Availability zone inside the region; empty lets AWS pick one.",
      "string":  {
        "maxLen":  "24",
        "pattern":  "^[a-z]{2}(-[a-z]+)+-\\d[a-z]$"
      },
      "group":  "Placement",
      "title":  "Availability zone",
      "examples":  [
        {
          "stringValue":  "eu-central-1a"
        }
      ]
    },
    {
      "name":  "network",
      "description":  "Create a throwaway VPC for every run, or place runs into an existing one.",
      "required":  true,
      "oneOf":  {
        "discriminator":  "kind",
        "variants":  {
          "create":  {
            "fields":  [
              {
                "name":  "cidr",
                "description":  "IPv4 range of the VPC created for the run.",
                "string":  {
                  "default":  "10.130.0.0/16",
                  "pattern":  "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
                },
                "title":  "VPC CIDR"
              }
            ]
          },
          "existing":  {
            "fields":  [
              {
                "name":  "vpc_id",
                "description":  "Existing VPC the machines join.",
                "required":  true,
                "string":  {
                  "pattern":  "^vpc-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title":  "VPC id"
              },
              {
                "name":  "subnet_id",
                "description":  "Existing subnet in the chosen availability zone.",
                "required":  true,
                "string":  {
                  "pattern":  "^subnet-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title":  "Subnet id"
              },
              {
                "name":  "security_group_id",
                "description":  "Existing security group applied to every machine.",
                "string":  {
                  "pattern":  "^sg-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title":  "Security group id"
              }
            ]
          }
        }
      },
      "group":  "Network",
      "title":  "Network"
    },
    {
      "name":  "instance_family",
      "description":  "EC2 family the size table resolves instance types in.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "m6i"
            },
            "label":  "m6i — general purpose, Ice Lake"
          },
          {
            "value":  {
              "stringValue":  "m7i"
            },
            "label":  "m7i — general purpose, Sapphire Rapids"
          },
          {
            "value":  {
              "stringValue":  "m6a"
            },
            "label":  "m6a — general purpose, AMD Milan"
          },
          {
            "value":  {
              "stringValue":  "m7a"
            },
            "label":  "m7a — general purpose, AMD Genoa"
          },
          {
            "value":  {
              "stringValue":  "c6i"
            },
            "label":  "c6i — compute optimized, Ice Lake"
          },
          {
            "value":  {
              "stringValue":  "c7i"
            },
            "label":  "c7i — compute optimized, Sapphire Rapids"
          },
          {
            "value":  {
              "stringValue":  "r6i"
            },
            "label":  "r6i — memory optimized, Ice Lake"
          },
          {
            "value":  {
              "stringValue":  "r7i"
            },
            "label":  "r7i — memory optimized, Sapphire Rapids"
          }
        ],
        "default":  {
          "stringValue":  "m7i"
        }
      },
      "group":  "Placement",
      "title":  "Instance family"
    },
    {
      "name":  "ami_family",
      "description":  "Boot image family; the concrete AMI id is resolved per region at launch.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "ubuntu-24.04"
            },
            "label":  "Ubuntu 24.04 LTS (noble)"
          },
          {
            "value":  {
              "stringValue":  "ubuntu-22.04"
            },
            "label":  "Ubuntu 22.04 LTS (jammy)"
          },
          {
            "value":  {
              "stringValue":  "al2023"
            },
            "label":  "Amazon Linux 2023"
          }
        ],
        "default":  {
          "stringValue":  "ubuntu-24.04"
        }
      },
      "group":  "Placement",
      "title":  "AMI family"
    },
    {
      "name":  "public_ips",
      "description":  "Give every machine a public IPv4 address.",
      "bool":  {
        "default":  true
      },
      "group":  "Network",
      "title":  "Public IPs"
    },
    {
      "name":  "spot",
      "description":  "Use Spot capacity: much cheaper, but interruptible with a two-minute notice — do not use for a measurement that must complete.",
      "bool":  {
        "default":  false
      },
      "group":  "Placement",
      "title":  "Spot instances"
    }
  ],
  "strict":  true,
  "coerce":  true
}
