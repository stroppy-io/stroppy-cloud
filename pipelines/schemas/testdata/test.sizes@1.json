{
  "coerce": true,
  "defs": {
    "machine": {
      "fields": [
        {
          "int64": {
            "gte": "1",
            "lte": "288"
          },
          "name": "cpu",
          "title": "vCPU"
        },
        {
          "int64": {
            "gte": "1",
            "lte": "4096"
          },
          "name": "memory_gb",
          "title": "Memory",
          "unit": "GB"
        },
        {
          "description": "Omit for a 40 GiB SSD OS disk.",
          "group": "Storage",
          "name": "boot_disk",
          "nullable": true,
          "object": {
            "schema": {
              "fields": [
                {
                  "description": "YC physical block size in bytes (4096..131072 powers of two); omitted selects the smallest size that fits the disk. AWS does not expose this setting.",
                  "group": "Storage",
                  "int64": {
                    "gte": "4096",
                    "lte": "131072"
                  },
                  "name": "block_size",
                  "title": "Physical block size",
                  "unit": "bytes"
                },
                {
                  "description": "OS disk size in GiB; must fit the selected image.",
                  "group": "Storage",
                  "int64": {
                    "gte": "10",
                    "lte": "262144"
                  },
                  "name": "gb",
                  "required": true,
                  "title": "Size",
                  "unit": "GiB"
                },
                {
                  "description": "Cloud disk type.",
                  "group": "Storage",
                  "name": "type",
                  "required": true,
                  "string": {
                    "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                  },
                  "title": "Type"
                }
              ],
              "strict": true
            }
          },
          "title": "Boot disk"
        },
        {
          "description": "YC guaranteed CPU percentage; omission means 100. Unsupported on AWS.",
          "group": "Compute",
          "int64": {
            "gte": "5",
            "lte": "100"
          },
          "name": "core_fraction",
          "title": "Guaranteed CPU",
          "unit": "%"
        },
        {
          "bool": {},
          "description": "Override the provider profile's preemptible/spot setting; explicit false is preserved.",
          "group": "Compute",
          "name": "preemptible",
          "title": "Preemptible"
        },
        {
          "bool": {},
          "description": "Override public addressing for this VM; outbound connectivity remains required for the agent and image pulls.",
          "group": "Network",
          "name": "public_ip",
          "title": "Public IP"
        },
        {
          "description": "Secondary disks beyond the boot disk.",
          "list": {
            "items": [
              {
                "object": {
                  "schema": {
                    "fields": [
                      {
                        "description": "YC physical block size in bytes (4096..131072 powers of two); omitted selects the smallest size that fits the disk. AWS does not expose this setting.",
                        "group": "Storage",
                        "int64": {
                          "gte": "4096",
                          "lte": "131072"
                        },
                        "name": "block_size",
                        "title": "Physical block size",
                        "unit": "bytes"
                      },
                      {
                        "name": "name",
                        "required": true,
                        "string": {
                          "pattern": "^[a-z][a-z0-9-]{0,62}$"
                        },
                        "title": "Device name"
                      },
                      {
                        "int64": {
                          "gte": "1",
                          "lte": "262144"
                        },
                        "name": "gb",
                        "required": true,
                        "title": "Size",
                        "unit": "GB"
                      },
                      {
                        "description": "Provider disk type id, e.g. network-ssd (yandex) or gp3 (aws).",
                        "name": "type",
                        "required": true,
                        "string": {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                        },
                        "title": "Disk type"
                      },
                      {
                        "choice": {
                          "options": [
                            {
                              "label": "ext4",
                              "value": {
                                "stringValue": "ext4"
                              }
                            },
                            {
                              "label": "XFS",
                              "value": {
                                "stringValue": "xfs"
                              }
                            }
                          ]
                        },
                        "description": "Automatic filesystem for mounted YC disks; omit for ext4. No mount means a raw block device.",
                        "group": "Storage",
                        "name": "filesystem",
                        "title": "Filesystem"
                      },
                      {
                        "description": "mount/fstab options, e.g. noatime; omission uses defaults.",
                        "group": "Storage",
                        "list": {
                          "items": [
                            {
                              "string": {
                                "maxLen": "128",
                                "pattern": "^[A-Za-z0-9_=.-]+$"
                              }
                            }
                          ],
                          "maxItems": "32"
                        },
                        "name": "mount_options",
                        "title": "Mount options"
                      },
                      {
                        "description": "Absolute path host_prep mounts the disk at; empty leaves it raw.",
                        "name": "mount",
                        "string": {
                          "pattern": "^/[A-Za-z0-9._/-]*$"
                        },
                        "title": "Mount point"
                      }
                    ],
                    "strict": true
                  }
                }
              }
            ],
            "maxItems": "16"
          },
          "name": "disks",
          "title": "Extra disks"
        },
        {
          "description": "Resolved boot image (family id, image id or AMI id).",
          "name": "image",
          "string": {
            "maxLen": "256",
            "minLen": "1"
          },
          "title": "Image"
        },
        {
          "description": "Zone (yandex) or availability zone (aws) the machine is created in.",
          "name": "location",
          "string": {
            "maxLen": "64",
            "minLen": "1"
          },
          "title": "Location"
        },
        {
          "description": "Platform id (yandex) or EC2 instance type (aws) from the size table.",
          "name": "instance_type",
          "string": {
            "maxLen": "64",
            "minLen": "1"
          },
          "title": "Instance type"
        },
        {
          "description": "Provider labels; the run and role labels are added by the pipeline.",
          "map": {
            "maxEntries": "32",
            "valueField": {
              "name": "value",
              "string": {
                "maxLen": "255"
              }
            }
          },
          "name": "labels",
          "title": "Labels"
        }
      ],
      "id": {
        "name": "machine",
        "namespace": "test",
        "version": "v1.0.0"
      },
      "strict": true
    }
  },
  "description": "Per-role machine sizing of a test: a T-shirt size and an optional disk override.",
  "fields": [
    {
      "description": "Keys are topology roles (db, db-replica, proxy, runner, coordinator); the server validates them against the database topology.",
      "group": "Sizing",
      "map": {
        "maxEntries": "16",
        "minEntries": "1",
        "valueSchema": {
          "fields": [
            {
              "choice": {
                "options": [
                  {
                    "label": "XS",
                    "value": {
                      "stringValue": "XS"
                    }
                  },
                  {
                    "label": "S",
                    "value": {
                      "stringValue": "S"
                    }
                  },
                  {
                    "label": "M",
                    "value": {
                      "stringValue": "M"
                    }
                  },
                  {
                    "label": "L",
                    "value": {
                      "stringValue": "L"
                    }
                  },
                  {
                    "label": "XL",
                    "value": {
                      "stringValue": "XL"
                    }
                  }
                ]
              },
              "description": "T-shirt size; the platform size table turns it into a machine.",
              "name": "size",
              "required": true,
              "title": "Size"
            },
            {
              "description": "Override any hardware field from the selected preset; explicit disks replace the preset disk list.",
              "group": "Sizing",
              "name": "machine",
              "ref": {
                "name": "machine"
              },
              "title": "Machine"
            },
            {
              "description": "Overrides the disk the size table would pick; absent means take the default.",
              "name": "disk",
              "nullable": true,
              "object": {
                "schema": {
                  "fields": [
                    {
                      "description": "Provider disk type id; empty keeps the size table's default.",
                      "name": "type",
                      "string": {
                        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                      },
                      "title": "Disk type"
                    },
                    {
                      "description": "Data disk size; empty keeps the size table's default.",
                      "int64": {
                        "gte": "10",
                        "lte": "262144"
                      },
                      "name": "gb",
                      "title": "Size",
                      "unit": "GB"
                    }
                  ],
                  "strict": true
                }
              },
              "title": "Disk"
            }
          ],
          "strict": true
        }
      },
      "name": "roles",
      "required": true,
      "title": "Roles"
    }
  ],
  "id": {
    "name": "sizes",
    "namespace": "test",
    "version": "v1.0.0"
  },
  "strict": true
}
