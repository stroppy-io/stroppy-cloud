{
  "coerce": true,
  "description": "Outgoing webhook of a tenant: endpoint, subscribed events and signing secret.",
  "fields": [
    {
      "description": "HTTPS endpoint the event is POSTed to.",
      "examples": [
        {
          "stringValue": "https://ci.example.com/hooks/stroppy"
        }
      ],
      "group": "Delivery",
      "name": "url",
      "required": true,
      "string": {
        "format": "url",
        "maxLen": "2048",
        "pattern": "^https://"
      },
      "title": "Endpoint"
    },
    {
      "description": "Which events are delivered; at least one.",
      "group": "Delivery",
      "list": {
        "items": [
          {
            "choice": {
              "options": [
                {
                  "label": "Run started",
                  "value": {
                    "stringValue": "run.started"
                  }
                },
                {
                  "label": "Run changed phase",
                  "value": {
                    "stringValue": "run.stage"
                  }
                },
                {
                  "label": "Run finished",
                  "value": {
                    "stringValue": "run.finished"
                  }
                },
                {
                  "label": "Run failed",
                  "value": {
                    "stringValue": "run.failed"
                  }
                },
                {
                  "label": "Run canceled",
                  "value": {
                    "stringValue": "run.cancelled"
                  }
                },
                {
                  "label": "Suite started",
                  "value": {
                    "stringValue": "suite.started"
                  }
                },
                {
                  "label": "Suite cell finished",
                  "value": {
                    "stringValue": "suite.cell_finished"
                  }
                },
                {
                  "label": "Suite finished",
                  "value": {
                    "stringValue": "suite.finished"
                  }
                }
              ]
            }
          }
        ],
        "maxItems": "8",
        "minItems": "1",
        "unique": true
      },
      "name": "events",
      "required": true,
      "title": "Events"
    },
    {
      "description": "Shared secret for the HMAC-SHA256 signature; shown once at creation.",
      "group": "Delivery",
      "name": "secret",
      "required": true,
      "secret": true,
      "string": {
        "maxLen": "256",
        "minLen": "16"
      },
      "title": "Signing secret"
    },
    {
      "bool": {
        "default": true
      },
      "description": "Deliveries are paused while this is off; the subscription is kept.",
      "group": "Delivery",
      "name": "enabled",
      "title": "Enabled"
    },
    {
      "description": "What this hook is for, for whoever finds it later.",
      "group": "Delivery",
      "name": "description",
      "string": {
        "maxLen": "512"
      },
      "title": "Description"
    }
  ],
  "id": {
    "name": "webhook",
    "namespace": "tenant",
    "version": "v1.0.0"
  },
  "strict": true
}
