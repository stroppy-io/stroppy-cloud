{
  "coerce": true,
  "description": "Params of stroppy-provider-verify: can these credentials create and destroy resources?",
  "fields": [
    {
      "choice": {
        "options": [
          {
            "label": "Yandex Cloud",
            "value": {
              "stringValue": "yandex"
            }
          },
          {
            "label": "AWS",
            "value": {
              "stringValue": "aws"
            }
          }
        ]
      },
      "description": "Cloud the credentials belong to.",
      "group": "Provider",
      "name": "provider",
      "required": true,
      "title": "Provider"
    },
    {
      "description": "Baked provider.\u003ckind\u003e.settings value being verified.",
      "group": "Provider",
      "json": {},
      "name": "settings",
      "required": true,
      "title": "Settings"
    },
    {
      "description": "Name of the Graphene secret holding the credentials — never the value.",
      "group": "Provider",
      "name": "credentials_secret",
      "required": true,
      "string": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
      },
      "title": "Credentials secret"
    },
    {
      "bool": {
        "default": true
      },
      "description": "Only read the account (identity, permissions); do not create a probe resource.",
      "group": "Verification",
      "name": "dry_run",
      "title": "Dry run"
    }
  ],
  "id": {
    "name": "provider_verify",
    "namespace": "spec",
    "version": "v1.0.0"
  },
  "strict": true
}
