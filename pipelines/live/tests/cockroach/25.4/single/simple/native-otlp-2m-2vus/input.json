      "role": "db",
      "machine": "db-1",
      "image": "docker.stroppy.io/cockroachdb/cockroach:v25.4.16",
      "entrypoint": [
        "/bin/sh"
      ],
      "cmd": [
        "-c",
        "set -e\nuntil cockroach sql --insecure --host=${ip:db-1}:26257 -e 'SELECT 1'; do sleep 3; done\ntouch /tmp/stroppy-init-done\nwhile true; do sleep 3600; done"
      ],
      "files": [
        {
          "path": "/etc/stroppy/settings.sql",
          "content": "-- managed by stroppy-cloud — cfg.cockroach.flags@25\n\n"
        },
        {
          "path": "/etc/stroppy/init.sql",
          "content": ""
        }
      ],
      "depends_on": [
        "db-1-cockroach"
      ],
      "healthcheck": {
        "cmd": [
          "CMD-SHELL",
          "test -f /tmp/stroppy-init-done"
