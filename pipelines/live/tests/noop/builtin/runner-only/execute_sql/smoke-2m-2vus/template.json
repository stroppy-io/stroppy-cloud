{
  "run_id": "14b4a148-ca1c-4ad6-8638-5d2fa66769e9",
  "tenant": "stroppy-live",
  "provider": {
    "kind": "yandex",
    "settings": {
      "cloud_id": "b1gt6m4l9gfhaobcgb81",
      "folder_id": "b1ghttqg66t14ldkvfcq",
      "zone": "ru-central1-d",
      "platform_id": "standard-v3",
      "public_ips": true,
      "preemptible": false
    },
    "credentials_secret": "yc-sa-key",
    "provider_config_name": "t-stroppy-live"
  },
  "network": {
    "cidr": "10.130.0.0/24",
    "allow_public_ips": true
  },
  "machines": [
    {
      "name": "runner-1",
      "role": "runner",
      "cpu": 4,
      "memory_gb": 8,
      "image": "ubuntu-2404-lts",
      "location": "ru-central1-d",
      "instance_type": "standard-v3",
      "labels": {
        "stroppy.io/engine": "stroppy",
        "stroppy.io/role": "runner"
      }
    }
  ],
  "containers": [
    {
      "name": "runner-1-node-exporter",
      "role": "runner",
      "machine": "runner-1",
      "image": "docker.stroppy.io/prometheus/node-exporter:v1.12.1",
      "cmd": [
        "--path.rootfs=/host",
        "--path.procfs=/host/proc",
        "--path.sysfs=/host/sys",
        "--path.udev.data=/host/run/udev/data",
        "--web.listen-address=:9100"
      ],
      "ports": [
        {
          "container": 9100,
          "host": 9100
        }
      ],
      "mounts": [
        {
          "source": "/",
          "target": "/host",
          "ro": true
        }
      ],
      "scrape": "/metrics",
      "restart": "always"
    }
  ],
  "workload": {
    "runner_role": "runner",
    "stroppy_image": "docker.stroppy.io/stroppy-io/stroppy:v6.0.0.62",
    "driver_type": "noop",
    "url": "noop://localhost",
    "segments": [
      {
        "log_level": "info",
        "name": "smoke",
        "run": {
          "duration": "30s",
          "executor": "constant-vus",
          "query_timeout": "0s",
          "vus": 2
        },
        "warmup": "0s",
        "workload": {
          "script": "simple"
        }
      }
    ]
  },
  "result_expectations": [
    "iterations_total"
  ]
}
