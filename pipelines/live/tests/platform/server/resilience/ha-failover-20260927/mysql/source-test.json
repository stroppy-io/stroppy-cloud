          "proxysql": 1,
          "replicas": 2,
          "replication": "group",
          "single_primary": true,
          "version": "8.4",
          "init_sql": "USE stroppy;\nCREATE TABLE live_cluster_probe (id INT PRIMARY KEY, writes BIGINT NOT NULL);\nDELIMITER //\nCREATE PROCEDURE live_assert_cluster()\nBEGIN\n  IF NOT COALESCE(((SELECT COUNT(*)=3 AND SUM(MEMBER_STATE='ONLINE')=3 AND SUM(MEMBER_ROLE='PRIMARY')=1 FROM performance_schema.replication_group_members)), 0) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='live acceptance: expected three healthy cluster members';\n  END IF;\n  INSERT INTO live_cluster_probe VALUES (1,1) ON DUPLICATE KEY UPDATE writes=writes+1;\nEND//\nDELIMITER ;\n"
        },
        "schema": {
          "id": "db.mysql.params",
          "version": "1"
        }
      }
