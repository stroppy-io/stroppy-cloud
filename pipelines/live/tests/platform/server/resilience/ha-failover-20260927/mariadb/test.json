    "database": {
      "inline": {
        "kind": "mariadb",
        "version": "11.8",
        "params": {
          "galera_nodes": 3,
          "init_sql": "USE stroppy;\nCREATE TABLE live_ha_markers (id INT PRIMARY KEY, payload VARCHAR(100) NOT NULL, writer VARCHAR(100) NOT NULL);\nCREATE TABLE live_ha_control (id INT PRIMARY KEY, done INT NOT NULL);\nINSERT INTO live_ha_control VALUES (1,0);\nDELIMITER //\nCREATE PROCEDURE live_ha_verify()\nBEGIN\n  IF (SELECT done FROM live_ha_control WHERE id=1) <> 1 THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='HA failover probe did not complete';\n  END IF;\nEND//\nDELIMITER ;\n",
          "maxscale": false,
          "proxysql": 1,
          "replicas": 0,
          "replication": "galera",
          "version": "11.8"
        },
        "schema": {
          "id": "db.mariadb.params",
          "version": "1"
