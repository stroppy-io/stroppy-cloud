{
  "suite_run_id": "cd74e12d-46ff-49e0-b76d-05a90659f1fd",
  "tenant": "stroppy-live",
  "concurrency": 1,
  "defaults": {
    "continue_on_failure": true
  },
  "cells": [
    {
      "id": "ydb-managed-serverless",
      "run_spec": {
        "run_id": "4f01f4e1-a59c-4b42-afb4-ab85476e209f",
        "tenant": "stroppy-live",
        "provider": {
          "kind": "yandex",
          "settings": {
            "cloud_id": "b1gt6m4l9gfhaobcgb81",
            "folder_id": "b1ghttqg66t14ldkvfcq",
            "zone": "ru-central1-a",
            "platform_id": "standard-v3",
            "public_ips": true,
            "preemptible": false
          },
          "credentials_secret": "yc-sa-key",
          "provider_config_name": "t-stroppy-live"
        },
        "network": {
          "cidr": "10.130.0.0/24",
          "allow_public_ips": true
        },
        "machines": [
          {
            "name": "runner-1",
            "role": "runner",
            "cpu": 4,
            "memory_gb": 8,
            "image": "ubuntu-2404-lts",
            "location": "ru-central1-a",
            "instance_type": "standard-v3",
            "labels": {
              "stroppy.io/engine": "stroppy",
              "stroppy.io/role": "runner"
            }
          }
        ],
        "managed_ydb": {
          "type": "serverless",
          "location_id": "ru-central1",
          "storage_size_limit_gb": 50
        },
        "containers": [
          {
            "name": "runner-1-node-exporter",
            "role": "runner",
            "machine": "runner-1",
            "image": "docker.stroppy.io/prometheus/node-exporter:v1.12.1",
            "cmd": [
              "--path.rootfs=/host",
              "--path.procfs=/host/proc",
              "--path.sysfs=/host/sys",
              "--path.udev.data=/host/run/udev/data",
              "--web.listen-address=:9100"
            ],
            "ports": [
              {
                "container": 9100,
                "host": 9100
              }
            ],
            "mounts": [
              {
                "source": "/",
                "target": "/host",
                "ro": true
              }
            ],
            "scrape": "/metrics",
            "restart": "always"
          }
        ],
        "workload": {
          "runner_role": "runner",
          "stroppy_image": "docker.stroppy.io/stroppy-io/stroppy@sha256:d1083cac1321793911e39b00043afd8167ed2aa69fec5c0429fa17c7ef2ce945",
          "driver_type": "ydb",
          "url": "grpcs://managed-ydb-pending:2135/?database=/pending",
          "segments": [
            {
              "name": "simple",
              "workload": {
                "script": "simple"
              },
              "run": {
                "executor": "constant-vus",
                "vus": 2,
                "duration": "2m"
              }
            },
            {
              "name": "tpcb-tx",
              "workload": {
                "script": "tpcb/tx",
                "scale_factor": 1,
                "load_workers": 2,
                "retry_attempts": 50
              },
              "run": {
                "executor": "constant-vus",
                "vus": 2,
                "duration": "20s"
              }
            },
            {
              "name": "tpcc-tx",
              "workload": {
                "script": "tpcc/tx",
                "scale_factor": 1,
                "load_workers": 2,
                "retry_attempts": 50
              },
              "run": {
                "executor": "constant-vus",
                "vus": 2,
                "duration": "20s"
              }
            }
          ],
          "ydb_iam_credentials_secret": "yc-sa-key"
        },
        "result_expectations": [
          "iterations_total"
        ],
        "observability": {
          "otlp_endpoint": "https://otel.stroppy.io",
          "labels": {
            "campaign": "native-tps-otlp"
          },
          "otlp_headers": ""
        }
      }
    }
  ]
}
