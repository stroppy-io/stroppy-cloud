# Copy to .env.compose (gitignored), chmod 600 .env.compose, then make dev.
# This is a real Graphene connection, not STROPPY_LOCAL_STAND simulation.
STROPPY_LOCAL_PORT=18347
STROPPY_HTTP_PUBLIC_URL=http://localhost:18347
STROPPY_INFRA_POSTGRES_PASSWORD=stroppy

# Local API token: dev. This account is the local platform admin.
STROPPY_DEV_USERS=dev=dev@stroppy.local=Developer
STROPPY_ADMIN_EMAILS=dev@stroppy.local

# An existing Graphene service-account credential with tenant namespace access.
STROPPY_INFRA_GRAPHENE_ADDRESS=graphene.stroppy.io:443
STROPPY_INFRA_GRAPHENE_TOKEN=
STROPPY_INFRA_GRAPHENE_INSECURE=false

# Registry proxying Docker Hub, GHCR and Quay for run machines.
STROPPY_INFRA_REGISTRY_MIRROR=docker.stroppy.io
