{
  "name": "stroppy-cloud-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-grafana-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "generate": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "test:contract": "node --experimental-strip-types --test tests/contract.test.mjs",
    "postinstall": "node scripts/copy-grafana-assets.mjs"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@grafana/data": "13.2.2",
    "@grafana/ui": "13.2.2",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12",
    "i18next": "^25.7.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "7",
    "typescript": "~5.8.3",
    "vite": "^7.2.7",
    "vitest": "^5.0.2"
  }
}
