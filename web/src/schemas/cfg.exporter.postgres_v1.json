{
  "id":  {
    "namespace":  "cfg",
    "name":  "exporter.postgres",
    "version":  "v1.0.0"
  },
  "description":  "postgres_exporter flags and environment (prometheus-community/postgres_exporter v0.20.x).",
  "fields":  [
    {
      "name":  "data_source_name",
      "description":  "libpq connection string or URI the exporter scrapes, e.g. postgresql://exporter@10.0.0.11:5432/postgres?sslmode=disable. Filled by the server from the topology; it carries a password, so it is a secret.",
      "nullable":  true,
      "string":  {
        "minLen":  "1",
        "maxLen":  "2048"
      },
      "group":  "Cluster",
      "title":  "DATA_SOURCE_NAME",
      "secret":  true
    },
    {
      "name":  "web_listen_port",
      "description":  "Port the exporter serves /metrics on; rendered as --web.listen-address=:<port>.",
      "int64":  {
        "default":  "9187",
        "gte":  "1",
        "lte":  "65535"
      },
      "group":  "Web",
      "title":  "Listen port"
    },
    {
      "name":  "web_telemetry_path",
      "description":  "HTTP path the metrics are exposed under.",
      "string":  {
        "default":  "/metrics",
        "pattern":  "^/.*$"
      },
      "group":  "Web",
      "title":  "Telemetry path"
    },
    {
      "name":  "log_level",
      "description":  "Exporter log verbosity.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "debug"
            },
            "label":  "debug"
          },
          {
            "value":  {
              "stringValue":  "info"
            },
            "label":  "info"
          },
          {
            "value":  {
              "stringValue":  "warn"
            },
            "label":  "warn"
          },
          {
            "value":  {
              "stringValue":  "error"
            },
            "label":  "error"
          }
        ],
        "default":  {
          "stringValue":  "info"
        }
      },
      "group":  "Logging",
      "title":  "Log level"
    },
    {
      "name":  "log_format",
      "description":  "Exporter log encoding.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "logfmt"
            },
            "label":  "logfmt"
          },
          {
            "value":  {
              "stringValue":  "json"
            },
            "label":  "json"
          }
        ],
        "default":  {
          "stringValue":  "logfmt"
        }
      },
      "group":  "Logging",
      "title":  "Log format"
    },
    {
      "name":  "disable_default_metrics",
      "description":  "Drop every built-in metric and export only the custom queries.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "on"
            },
            "label":  "on"
          },
          {
            "value":  {
              "stringValue":  "off"
            },
            "label":  "off"
          }
        ],
        "default":  {
          "stringValue":  "off"
        }
      },
      "group":  "Metrics",
      "title":  "Disable default metrics"
    },
    {
      "name":  "metric_prefix",
      "description":  "Prefix of every exported metric name.",
      "string":  {
        "default":  "pg",
        "pattern":  "^[a-z_][a-z0-9_]*$"
      },
      "group":  "Metrics",
      "title":  "Metric prefix"
    },
    {
      "name":  "collection_timeout",
      "description":  "Timeout for one scrape, as a Go duration; a slow database is reported as a failed scrape instead of stalling Prometheus.",
      "string":  {
        "default":  "1m",
        "pattern":  "^[0-9]+(ms|s|m|h)$"
      },
      "group":  "Metrics",
      "title":  "Collection timeout"
    },
    {
      "name":  "auto_discover_databases",
      "description":  "Scrape every database on the server, not just the one in DATA_SOURCE_NAME. Deprecated upstream.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "on"
            },
            "label":  "on"
          },
          {
            "value":  {
              "stringValue":  "off"
            },
            "label":  "off"
          }
        ],
        "default":  {
          "stringValue":  "off"
        }
      },
      "group":  "Discovery",
      "title":  "Auto-discover databases",
      "deprecated":  true
    },
    {
      "name":  "exclude_databases",
      "description":  "Comma-separated databases to skip when auto-discovery is on. Deprecated upstream.",
      "string":  {
        "default":  "template0,template1",
        "maxLen":  "1024"
      },
      "group":  "Discovery",
      "title":  "Exclude databases",
      "deprecated":  true
    },
    {
      "name":  "include_databases",
      "description":  "Comma-separated databases to restrict auto-discovery to. Deprecated upstream.",
      "string":  {
        "default":  "",
        "maxLen":  "1024"
      },
      "group":  "Discovery",
      "title":  "Include databases",
      "deprecated":  true
    },
    {
      "name":  "collector_database",
      "description":  "Per-database size and connection counts. Upstream default: on.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "on"
            },
            "label":  "on"
          },
          {
            "value":  {
              "stringValue":  "off"
            },
            "label":  "off"
          }
        ],
        "default":  {
          "stringValue":  "on"
        }
      },
      "group":  "Collectors",
      "title":  "collector.database"
    },
    {
