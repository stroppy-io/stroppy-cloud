    {
      "name":  "collector_flags",
      "description":  "Every collector rendered as --collector.<name> or --no-collector.<name>, in table order.",
      "computed":  {
        "expr":  "[(root.collector_database == \"on\" ? \"--collector.database\" : \"--no-collector.database\"),\n(root.collector_database_wraparound == \"on\" ? \"--collector.database_wraparound\" : \"--no-collector.database_wraparound\"),\n(root.collector_locks == \"on\" ? \"--collector.locks\" : \"--no-collector.locks\"),\n(root.collector_long_running_transactions == \"on\" ? \"--collector.long_running_transactions\" : \"--no-collector.long_running_transactions\"),\n(root.collector_postmaster == \"on\" ? \"--collector.postmaster\" : \"--no-collector.postmaster\"),\n(root.collector_process_idle == \"on\" ? \"--collector.process_idle\" : \"--no-collector.process_idle\"),\n(root.collector_replication == \"on\" ? \"--collector.replication\" : \"--no-collector.replication\"),\n(root.collector_replication_slots == \"on\" ? \"--collector.replication_slots\" : \"--no-collector.replication_slots\"),\n(root.collector_roles == \"on\" ? \"--collector.roles\" : \"--no-collector.roles\"),\n(root.collector_settings == \"on\" ? \"--collector.settings\" : \"--no-collector.settings\"),\n(root.collector_stat_activity == \"on\" ? \"--collector.stat_activity\" : \"--no-collector.stat_activity\"),\n(root.collector_stat_activity_autovacuum == \"on\" ? \"--collector.stat_activity_autovacuum\" : \"--no-collector.stat_activity_autovacuum\"),\n(root.collector_stat_archiver == \"on\" ? \"--collector.stat_archiver\" : \"--no-collector.stat_archiver\"),\n(root.collector_stat_bgwriter == \"on\" ? \"--collector.stat_bgwriter\" : \"--no-collector.stat_bgwriter\"),\n(root.collector_stat_checkpointer == \"on\" ? \"--collector.stat_checkpointer\" : \"--no-collector.stat_checkpointer\"),\n(root.collector_stat_database == \"on\" ? \"--collector.stat_database\" : \"--no-collector.stat_database\"),\n(root.collector_stat_progress_vacuum == \"on\" ? \"--collector.stat_progress_vacuum\" : \"--no-collector.stat_progress_vacuum\"),\n(root.collector_stat_replication == \"on\" ? \"--collector.stat_replication\" : \"--no-collector.stat_replication\"),\n(root.collector_stat_statements == \"on\" ? \"--collector.stat_statements\" : \"--no-collector.stat_statements\"),\n(root.collector_stat_user_tables == \"on\" ? \"--collector.stat_user_tables\" : \"--no-collector.stat_user_tables\"),\n(root.collector_stat_wal_receiver == \"on\" ? \"--collector.stat_wal_receiver\" : \"--no-collector.stat_wal_receiver\"),\n(root.collector_statio_user_indexes == \"on\" ? \"--collector.statio_user_indexes\" : \"--no-collector.statio_user_indexes\"),\n(root.collector_statio_user_tables == \"on\" ? \"--collector.statio_user_tables\" : \"--no-collector.statio_user_tables\"),\n(root.collector_wal == \"on\" ? \"--collector.wal\" : \"--no-collector.wal\"),\n(root.collector_xlog_location == \"on\" ? \"--collector.xlog_location\" : \"--no-collector.xlog_location\"),\n(root.collector_buffercache_summary == \"on\" ? \"--collector.buffercache_summary\" : \"--no-collector.buffercache_summary\")].join(\" \")",
        "result":  "RESULT_TYPE_STRING"
      },
      "group":  "Collectors",
      "title":  "Collector flags"
    },
    {
      "name":  "opts",
      "description":  "The full postgres_exporter argument list.",
      "computed":  {
        "expr":  "\"--web.listen-address=:\" + string(root.web_listen_port) + \" --web.telemetry-path=\" + root.web_telemetry_path + \" --log.level=\" + root.log_level + \" --log.format=\" + root.log_format + \" --metric-prefix=\" + root.metric_prefix + \" --collection-timeout=\" + root.collection_timeout + (root.disable_default_metrics == \"on\" ? \" --disable-default-metrics\" : \"\") + (root.auto_discover_databases == \"on\" ? \" --auto-discover-databases\" : \"\") + (root.exclude_databases != \"\" ? \" --exclude-databases=\" + root.exclude_databases : \"\") + (root.include_databases != \"\" ? \" --include-databases=\" + root.include_databases : \"\") + \" \" + root.collector_flags",
        "result":  "RESULT_TYPE_STRING"
      },
      "group":  "Collectors",
      "title":  "Command line"
    }
  ],
  "rules":  [
    {
      "expr":  "root.auto_discover_databases == \"on\" || root.include_databases == \"\"",
      "message":  "include_databases only applies when auto_discover_databases is on",
      "id":  "include-needs-discovery"
    },
    {
      "expr":  "root.collector_stat_statements == \"off\" || root.disable_default_metrics == \"off\"",
      "message":  "the stat_statements collector produces nothing with default metrics disabled",
      "id":  "stat-statements-needs-defaults"
    }
  ],
  "strict":  true,
  "coerce":  true,
  "templates":  {
    "conf":  "# postgres_exporter environment — generated by stroppy.\n{{#values.data_source_name}}DATA_SOURCE_NAME={{{.}}}\n{{/values.data_source_name}}PG_EXPORTER_WEB_TELEMETRY_PATH={{{values.web_telemetry_path}}}\nPG_EXPORTER_METRIC_PREFIX={{{values.metric_prefix}}}\nPG_EXPORTER_COLLECTION_TIMEOUT={{{values.collection_timeout}}}\nPOSTGRES_EXPORTER_OPTS={{{values.opts}}}\n"
  }
}
