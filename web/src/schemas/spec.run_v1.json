{
  "id":  {
    "namespace":  "spec",
    "name":  "run",
    "version":  "v1.0.0"
  },
  "description":  "RunSpec: the resolved description of one benchmark run handed to stroppy-run.",
  "fields":  [
    {
      "name":  "run_id",
      "description":  "Run id minted by the server; also the Graphene run id.",
      "required":  true,
      "string":  {
        "format":  "uuid"
      },
      "group":  "Identity",
      "title":  "Run id"
    },
    {
      "name":  "tenant",
      "description":  "Tenant slug; the Graphene namespace is t-<tenant>.",
      "required":  true,
      "string":  {
        "pattern":  "^[a-z][a-z0-9-]{0,62}$"
      },
      "group":  "Identity",
      "title":  "Tenant"
    },
    {
      "name":  "provider",
      "description":  "Where the run is created and with which credentials.",
      "required":  true,
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "kind",
              "description":  "Cloud the run is created in.",
              "required":  true,
              "choice":  {
                "options":  [
                  {
                    "value":  {
                      "stringValue":  "yandex"
                    },
                    "label":  "Yandex Cloud"
                  },
                  {
                    "value":  {
                      "stringValue":  "aws"
                    },
                    "label":  "AWS"
                  }
                ]
              },
              "title":  "Provider"
            },
            {
              "name":  "settings",
              "description":  "Baked provider.<kind>.settings value; non-secret placement settings.",
              "required":  true,
              "json":  {},
              "title":  "Settings"
            },
            {
              "name":  "credentials_secret",
              "description":  "Name of the Graphene secret holding the provider credentials — never the value.",
              "required":  true,
              "string":  {
                "pattern":  "^[a-z0-9][a-z0-9._-]{0,62}$"
              },
              "title":  "Credentials secret"
            },
            {
              "name":  "provider_config_name",
              "description":  "Crossplane ProviderConfig the managed resources reference (t-<tenant>).",
              "required":  true,
              "string":  {
                "pattern":  "^[a-z][a-z0-9-]{0,62}$"
              },
              "title":  "ProviderConfig"
            },
            {
              "name":  "registry_secret",
              "description":  "Name of the Graphene secret with a private docker registry login, when images need one.",
              "string":  {
                "pattern":  "^[a-z0-9][a-z0-9._-]{0,62}$"
              },
              "title":  "Registry secret"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Provider",
      "title":  "Provider"
    },
    {
      "name":  "network",
      "description":  "The network every machine of the run joins.",
      "required":  true,
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "cidr",
              "description":  "IPv4 range of the run network.",
              "string":  {
                "default":  "10.130.0.0/24",
                "pattern":  "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
              },
              "title":  "CIDR"
            },
            {
              "name":  "allow_public_ips",
              "description":  "Machines get a public address (needed when the agent has no private route out).",
              "bool":  {
                "default":  true
              },
              "title":  "Public IPs"
            },
            {
              "name":  "ingress",
              "description":  "Security group openings beyond the intra-network traffic.",
              "list":  {
                "items":  [
                  {
                    "object":  {
                      "schema":  {
                        "fields":  [
                          {
                            "name":  "port",
                            "required":  true,
                            "int64":  {
                              "gte":  "1",
                              "lte":  "65535"
                            },
                            "title":  "Port"
                          },
                          {
                            "name":  "proto",
                            "choice":  {
                              "options":  [
                                {
                                  "value":  {
                                    "stringValue":  "tcp"
                                  },
                                  "label":  "TCP"
                                },
                                {
                                  "value":  {
                                    "stringValue":  "udp"
                                  },
                                  "label":  "UDP"
                                }
                              ],
                              "default":  {
                                "stringValue":  "tcp"
                              }
                            },
                            "title":  "Protocol"
                          },
                          {
                            "name":  "cidr",
                            "description":  "Who may reach the port.",
                            "required":  true,
                            "string":  {
                              "pattern":  "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
                            },
                            "title":  "Source CIDR"
                          }
                        ],
                        "strict":  true
                      }
                    }
                  }
                ],
                "maxItems":  "64"
              },
              "title":  "Ingress"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Network",
      "title":  "Network"
    },
    {
      "name":  "managed_ydb",
      "description":  "YC database created and deleted with this run; no existing database is adopted.",
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "type",
              "description":  "Owned YC database type.",
              "required":  true,
              "choice":  {
                "options":  [
                  {
                    "value":  {
                      "stringValue":  "dedicated"
                    },
                    "label":  "Dedicated"
                  },
                  {
                    "value":  {
                      "stringValue":  "serverless"
                    },
                    "label":  "Serverless"
                  }
                ]
              },
              "group":  "Managed YDB",
              "title":  "Database type"
            },
            {
              "name":  "zones",
              "description":  "Dedicated database subnet zones.",
              "list":  {
                "items":  [
                  {
                    "string":  {
                      "pattern":  "^ru-central1-[abde]$"
                    }
                  }
                ],
                "minItems":  "3",
                "maxItems":  "3",
                "unique":  true
              },
              "group":  "Managed YDB",
              "title":  "Physical zones"
            },
            {
              "name":  "location_id",
              "description":  "YC region or location identifier.",
              "required":  true,
              "string":  {
                "pattern":  "^[a-z0-9-]{1,32}$"
              },
              "group":  "Managed YDB",
              "title":  "Location"
            },
            {
              "name":  "resource_preset_id",
              "description":  "Dedicated node resource preset.",
              "string":  {
                "pattern":  "^[a-z0-9-]{1,64}$"
              },
              "group":  "Managed YDB",
              "title":  "Compute preset"
            },
            {
              "name":  "node_count",
              "description":  "Dedicated fixed-scale node count.",
              "int64":  {
                "gte":  "1",
                "lte":  "64"
              },
              "group":  "Managed YDB",
              "title":  "Nodes"
            },
            {
              "name":  "storage_groups",
              "description":  "Dedicated storage group count.",
              "int64":  {
                "gte":  "1",
                "lte":  "1024"
              },
              "group":  "Managed YDB",
              "title":  "Storage groups"
            },
            {
              "name":  "storage_type",
              "description":  "Dedicated storage type identifier.",
              "string":  {
                "pattern":  "^[a-z0-9-]{1,64}$"
              },
              "group":  "Managed YDB",
              "title":  "Storage type"
            },
            {
              "name":  "assign_public_ips",
              "description":  "Whether dedicated database nodes receive public addresses.",
              "bool":  {},
              "group":  "Managed YDB",
              "title":  "Public addresses"
            },
            {
              "name":  "throttling_rcu_limit",
              "description":  "Serverless request units per second ceiling; zero disables throttling.",
              "int64":  {
                "gte":  "0",
                "lte":  "1000000"
              },
              "group":  "Managed YDB",
              "title":  "Request ceiling"
            },
            {
              "name":  "provisioned_rcu_limit",
              "description":  "Serverless reserved request units per second.",
              "int64":  {
                "gte":  "0",
                "lte":  "1000000"
              },
              "group":  "Managed YDB",
              "title":  "Provisioned capacity"
            },
            {
              "name":  "storage_size_limit_gb",
              "description":  "Serverless storage limit in GiB.",
              "int64":  {
                "gte":  "1",
                "lte":  "10000"
              },
              "group":  "Managed YDB",
              "title":  "Storage ceiling"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Managed YDB",
      "title":  "Managed YDB"
    },
    {
      "name":  "machines",
      "description":  "Every VM of the run; the pipeline creates one agent per machine.",
      "required":  true,
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "name",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "title":  "Name"
                  },
                  {
                    "name":  "role",
                    "description":  "Topology role; scrapes, containers and flows select on it.",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "Role"
                  },
                  {
                    "name":  "cpu",
                    "required":  true,
                    "int64":  {
                      "gte":  "1",
                      "lte":  "288"
                    },
                    "title":  "vCPU"
                  },
                  {
                    "name":  "memory_gb",
                    "required":  true,
                    "int64":  {
                      "gte":  "1",
                      "lte":  "4096"
                    },
                    "unit":  "GB",
                    "title":  "Memory"
                  },
                  {
                    "name":  "disks",
                    "description":  "Secondary disks beyond the boot disk.",
                    "list":  {
                      "items":  [
                        {
                          "object":  {
                            "schema":  {
                              "fields":  [
                                {
                                  "name":  "name",
                                  "required":  true,
                                  "string":  {
                                    "pattern":  "^[a-z][a-z0-9-]{0,62}$"
                                  },
                                  "title":  "Device name"
                                },
                                {
                                  "name":  "gb",
                                  "required":  true,
                                  "int64":  {
                                    "gte":  "1",
                                    "lte":  "262144"
                                  },
                                  "unit":  "GB",
                                  "title":  "Size"
                                },
                                {
                                  "name":  "type",
                                  "description":  "Provider disk type id, e.g. network-ssd (yandex) or gp3 (aws).",
                                  "required":  true,
                                  "string":  {
                                    "pattern":  "^[a-z0-9][a-z0-9-]{0,31}$"
                                  },
                                  "title":  "Disk type"
                                },
                                {
                                  "name":  "mount",
                                  "description":  "Absolute path host_prep mounts the disk at; empty leaves it raw.",
                                  "string":  {
                                    "pattern":  "^/[A-Za-z0-9._/-]*$"
                                  },
                                  "title":  "Mount point"
                                }
                              ],
                              "strict":  true
                            }
                          }
                        }
                      ],
                      "maxItems":  "16"
                    },
                    "title":  "Extra disks"
                  },
                  {
                    "name":  "image",
                    "description":  "Resolved boot image (family id, image id or AMI id).",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "256"
                    },
                    "title":  "Image"
                  },
                  {
                    "name":  "location",
                    "description":  "Zone (yandex) or availability zone (aws) the machine is created in.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "64"
                    },
                    "title":  "Location"
                  },
                  {
                    "name":  "instance_type",
                    "description":  "Platform id (yandex) or EC2 instance type (aws) from the size table.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "64"
                    },
                    "title":  "Instance type"
                  },
                  {
                    "name":  "labels",
                    "description":  "Provider labels; the run and role labels are added by the pipeline.",
                    "map":  {
                      "maxEntries":  "32",
                      "valueField":  {
                        "name":  "value",
                        "string":  {
                          "maxLen":  "255"
                        }
                      }
                    },
                    "title":  "Labels"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "minItems":  "1",
        "maxItems":  "64"
      },
      "group":  "Machines",
      "title":  "Machines"
    },
    {
      "name":  "containers",
      "description":  "Everything that runs on the machines: databases, proxies, exporters.",
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "name",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "title":  "Name"
                  },
                  {
                    "name":  "role",
                    "description":  "Role the container belongs to; used for logs, metrics and flows.",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "Role"
                  },
                  {
                    "name":  "machine",
                    "description":  "Name of the machine the container runs on.",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "title":  "Machine"
                  },
                  {
                    "name":  "image",
                    "description":  "Fully qualified docker image; every database is a container, no host packages.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "512"
                    },
                    "title":  "Image"
                  },
                  {
                    "name":  "cmd",
                    "description":  "Argv replacing the image command.",
                    "list":  {
                      "items":  [
                        {
                          "string":  {
                            "maxLen":  "1024"
                          }
                        }
                      ],
                      "maxItems":  "64"
                    },
                    "title":  "Command"
                  },
                  {
                    "name":  "entrypoint",
                    "description":  "Executable and arguments replacing the image entrypoint; omit to use the upstream image entrypoint.",
                    "list":  {
                      "items":  [
                        {
                          "string":  {
                            "minLen":  "1",
                            "maxLen":  "1024"
                          }
                        }
                      ],
                      "maxItems":  "64"
                    },
                    "group":  "Process",
                    "title":  "Entrypoint"
                  },
                  {
                    "name":  "env",
                    "map":  {
                      "maxEntries":  "128",
                      "valueField":  {
                        "name":  "value",
                        "string":  {
                          "maxLen":  "4096"
                        }
                      }
                    },
                    "title":  "Environment"
                  },
                  {
                    "name":  "ports",
                    "list":  {
                      "items":  [
                        {
                          "object":  {
                            "schema":  {
                              "fields":  [
                                {
                                  "name":  "container",
                                  "required":  true,
                                  "int64":  {
                                    "gte":  "1",
                                    "lte":  "65535"
                                  },
                                  "title":  "Container port"
                                },
                                {
                                  "name":  "host",
                                  "required":  true,
                                  "int64":  {
                                    "gte":  "1",
                                    "lte":  "65535"
                                  },
                                  "title":  "Host port"
                                }
                              ],
                              "strict":  true
                            }
                          }
                        }
                      ],
                      "maxItems":  "32"
                    },
                    "title":  "Ports"
                  },
                  {
                    "name":  "mounts",
                    "list":  {
                      "items":  [
                        {
                          "object":  {
                            "schema":  {
                              "fields":  [
                                {
                                  "name":  "source",
                                  "required":  true,
                                  "string":  {
                                    "pattern":  "^/[A-Za-z0-9._/-]*$"
                                  },
                                  "title":  "Host path"
                                },
                                {
                                  "name":  "target",
                                  "required":  true,
                                  "string":  {
                                    "pattern":  "^/[A-Za-z0-9._/-]*$"
                                  },
                                  "title":  "Container path"
                                },
                                {
                                  "name":  "ro",
                                  "bool":  {
                                    "default":  false
                                  },
                                  "title":  "Read-only"
                                }
                              ],
                              "strict":  true
                            }
                          }
                        }
                      ],
                      "maxItems":  "32"
                    },
                    "title":  "Mounts"
                  },
                  {
                    "name":  "files",
                    "description":  "Configs rendered by the server and injected at start.",
                    "list":  {
                      "items":  [
                        {
                          "object":  {
                            "schema":  {
                              "fields":  [
                                {
                                  "name":  "path",
                                  "description":  "Absolute path inside the container.",
                                  "required":  true,
                                  "string":  {
                                    "pattern":  "^/[A-Za-z0-9._/-]*$"
                                  },
                                  "title":  "Path"
                                },
                                {
                                  "name":  "content",
                                  "description":  "Rendered config text (cfg.* schema Render output).",
                                  "required":  true,
                                  "string":  {
                                    "maxLen":  "1048576"
                                  },
                                  "title":  "Content"
                                },
                                {
                                  "name":  "mode",
                                  "description":  "Octal file mode.",
                                  "string":  {
                                    "default":  "0644",
                                    "pattern":  "^0[0-7]{3}$"
                                  },
                                  "title":  "Mode"
                                }
                              ],
                              "strict":  true
                            }
                          }
                        }
                      ],
                      "maxItems":  "32"
                    },
                    "title":  "Files"
                  },
                  {
                    "name":  "scrape",
                    "description":  "Prometheus metrics path on the container, e.g. /metrics; empty = not scraped.",
                    "string":  {
                      "pattern":  "^/[A-Za-z0-9._/-]*$"
                    },
                    "title":  "Scrape path"
                  },
                  {
                    "name":  "scrape_port",
                    "description":  "HTTP port for the scrape path; when omitted, uses the first container port for compatibility.",
                    "int64":  {
                      "gte":  "1",
                      "lte":  "65535"
                    },
                    "group":  "Observability",
                    "title":  "Metrics port"
                  },
                  {
                    "name":  "depends_on",
                    "description":  "Container names started before this one.",
                    "list":  {
                      "items":  [
                        {
                          "string":  {
                            "pattern":  "^[a-z][a-z0-9-]{0,62}$"
                          }
                        }
                      ],
                      "maxItems":  "16",
                      "unique":  true
                    },
                    "title":  "Depends on"
                  },
                  {
                    "name":  "healthcheck",
                    "object":  {
                      "schema":  {
                        "fields":  [
                          {
                            "name":  "cmd",
                            "required":  true,
                            "list":  {
                              "items":  [
                                {
                                  "string":  {
                                    "maxLen":  "1024"
                                  }
                                }
                              ],
                              "minItems":  "1",
                              "maxItems":  "16"
                            },
                            "title":  "Command"
                          },
                          {
                            "name":  "interval",
                            "duration":  {
                              "default":  "5s",
                              "gte":  "1s",
                              "lte":  "3600s"
                            },
                            "title":  "Interval"
                          },
                          {
                            "name":  "retries",
                            "int64":  {
                              "default":  "30",
                              "gte":  "1",
                              "lte":  "100"
                            },
                            "title":  "Retries"
                          }
                        ],
                        "strict":  true
                      }
                    },
                    "title":  "Health check"
                  },
                  {
                    "name":  "restart",
                    "choice":  {
                      "options":  [
                        {
                          "value":  {
                            "stringValue":  "no"
                          },
                          "label":  "Never"
                        },
                        {
                          "value":  {
                            "stringValue":  "on-failure"
                          },
                          "label":  "On failure"
                        },
                        {
                          "value":  {
                            "stringValue":  "unless-stopped"
                          },
                          "label":  "Unless stopped"
                        },
                        {
                          "value":  {
                            "stringValue":  "always"
                          },
                          "label":  "Always"
                        }
                      ],
                      "default":  {
                        "stringValue":  "unless-stopped"
                      }
                    },
                    "title":  "Restart policy"
                  },
                  {
                    "name":  "ulimits",
                    "description":  "Soft limits, e.g. nofile; -1 = unlimited.",
                    "map":  {
                      "maxEntries":  "16",
                      "valueField":  {
                        "name":  "value",
                        "int64":  {
                          "gte":  "-1"
                        }
                      }
                    },
                    "title":  "Ulimits"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "maxItems":  "256"
      },
      "group":  "Containers",
      "title":  "Containers"
    },
    {
      "name":  "host_prep",
      "description":  "Rare pre-deploy steps run on the machine itself (machine.Command).",
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "role",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "Role"
                  },
                  {
                    "name":  "kind",
                    "description":  "What the step does before any container starts.",
                    "required":  true,
                    "choice":  {
                      "options":  [
                        {
                          "value":  {
                            "stringValue":  "sysctl"
                          },
                          "label":  "Kernel parameters"
                        },
                        {
                          "value":  {
                            "stringValue":  "disks"
                          },
                          "label":  "Format and mount extra disks"
                        },
                        {
                          "value":  {
                            "stringValue":  "script"
                          },
                          "label":  "Shell script"
                        }
                      ]
                    },
                    "title":  "Kind"
                  },
                  {
                    "name":  "content",
                    "description":  "sysctl lines, mount spec or shell script, per kind.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "65536"
                    },
                    "title":  "Content"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "maxItems":  "32"
      },
      "group":  "Machines",
      "title":  "Host preparation"
    },
    {
      "name":  "scrapes",
      "description":  "Agent-side Prometheus scrapes of exporters.",
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "role",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "Role"
                  },
                  {
                    "name":  "url",
                    "description":  "Metrics endpoint on the machine, e.g. http://127.0.0.1:9187/metrics.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "512"
                    },
                    "title":  "URL"
                  },
                  {
                    "name":  "job",
                    "description":  "Prometheus job label the samples land under.",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "Job"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "maxItems":  "64"
      },
      "group":  "Observability",
      "title":  "Scrapes"
    },
    {
      "name":  "flows",
      "description":  "Allowed traffic between roles; drives security groups and the topology view.",
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "from_role",
                    "required":  true,
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "From role"
                  },
                  {
                    "name":  "to_role",
                    "description":  "Target role; set this or external, not both.",
                    "string":  {
                      "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "title":  "To role"
                  },
                  {
                    "name":  "external",
                    "description":  "Host outside the run (registry, OTLP collector); set this or to_role.",
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "255"
                    },
                    "title":  "External target"
                  },
                  {
                    "name":  "protocol",
                    "required":  true,
                    "choice":  {
                      "options":  [
                        {
                          "value":  {
                            "stringValue":  "tcp"
                          },
                          "label":  "TCP"
                        },
                        {
                          "value":  {
                            "stringValue":  "http"
                          },
                          "label":  "HTTP"
                        },
                        {
                          "value":  {
                            "stringValue":  "grpc"
                          },
                          "label":  "gRPC"
                        },
                        {
                          "value":  {
                            "stringValue":  "prometheus_pull"
                          },
                          "label":  "Prometheus pull"
                        },
                        {
                          "value":  {
                            "stringValue":  "otlp"
                          },
                          "label":  "OTLP"
                        }
                      ]
                    },
                    "title":  "Protocol"
                  },
                  {
                    "name":  "port",
                    "required":  true,
                    "int64":  {
                      "gte":  "1",
                      "lte":  "65535"
                    },
                    "title":  "Port"
                  },
                  {
                    "name":  "label",
                    "description":  "Human label drawn on the topology view.",
                    "string":  {
                      "maxLen":  "64"
                    },
                    "title":  "Label"
                  }
                ],
                "rules":  [
                  {
                    "expr":  "(\"to_role\" in this) != (\"external\" in this)",
                    "message":  "a flow targets exactly one of to_role or external",
                    "id":  "flow-target-xor"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "maxItems":  "128"
      },
      "group":  "Network",
      "title":  "Flows"
    },
    {
      "name":  "workload",
      "description":  "What stroppy runs and where.",
      "required":  true,
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "runner_role",
              "description":  "Role of the machine stroppy runs on.",
              "required":  true,
              "string":  {
                "default":  "runner",
                "pattern":  "^[a-z][a-z0-9_-]{0,31}$"
              },
              "title":  "Runner role"
            },
            {
              "name":  "stroppy_image",
              "description":  "Resolved stroppy image from the catalog for the chosen version (6.0.0+).",
              "required":  true,
              "string":  {
                "minLen":  "1",
                "maxLen":  "512"
              },
              "title":  "Stroppy image"
            },
            {
              "name":  "driver_type",
              "description":  "stroppy driverType of drivers.0.",
              "required":  true,
              "choice":  {
                "options":  [
                  {
                    "value":  {
                      "stringValue":  "postgres"
                    },
                    "label":  "postgres"
                  },
                  {
                    "value":  {
                      "stringValue":  "mysql"
                    },
                    "label":  "mysql"
                  },
                  {
                    "value":  {
                      "stringValue":  "picodata"
                    },
                    "label":  "picodata"
                  },
                  {
                    "value":  {
                      "stringValue":  "ydb"
                    },
                    "label":  "ydb"
                  },
                  {
                    "value":  {
                      "stringValue":  "noop"
                    },
                    "label":  "noop"
                  }
                ]
              },
              "title":  "Driver type"
            },
            {
              "name":  "url",
              "description":  "drivers.0.url; may carry ${ip:...} placeholders the pipeline expands after provisioning.",
              "required":  true,
              "string":  {
                "minLen":  "1",
                "maxLen":  "2048"
              },
              "title":  "Connection URL"
            },
            {
              "name":  "driver",
              "description":  "Remaining drivers.0 keys of stroppy-config.json (bulkSize, pool, insertProgress, caCertFile, authToken…), already in stroppy's lowerCamel form.",
              "json":  {},
              "title":  "Driver options"
            },
            {
              "name":  "segments",
              "description":  "Baked workload.segment@1 values in order; opaque to the pipeline beyond the fields it interprets.",
              "required":  true,
              "list":  {
                "items":  [
                  {
                    "json":  {}
                  }
                ],
                "minItems":  "1",
                "maxItems":  "64"
              },
              "title":  "Segments"
            },
            {
              "name":  "baseline",
              "description":  "Baked workload.stroppy@1 baseline object; absent or disabled = no machine self-check.",
              "json":  {},
              "title":  "Baseline"
            },
            {
              "name":  "ydb_iam_credentials_secret",
              "description":  "Graphene secret containing YC service-account credentials; a short-lived IAM token is resolved on the runner into a temporary runtime config, never a retained artifact.",
              "string":  {
                "pattern":  "^[a-z0-9][a-z0-9._-]{0,62}$"
              },
              "group":  "Workload",
              "title":  "YDB credentials reference"
            },
            {
              "name":  "ca_cert",
              "description":  "PEM the pipeline writes next to the config and points caCertFile at.",
              "string":  {
                "maxLen":  "65536"
              },
              "title":  "CA certificate",
              "secret":  true
            }
          ],
          "strict":  true
        }
      },
      "group":  "Workload",
      "title":  "Workload"
    },
    {
      "name":  "observability",
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "otlp_endpoint",
              "description":  "Where agents forward stroppy metrics and logs.",
              "string":  {
                "minLen":  "1",
                "maxLen":  "512"
              },
              "title":  "OTLP endpoint"
            },
            {
              "name":  "otlp_headers",
              "description":  "Comma-separated key=value headers stroppy sends with every export (otlpHeaders).",
              "string":  {
                "maxLen":  "4096"
              },
              "title":  "OTLP headers",
              "secret":  true
            },
            {
              "name":  "labels",
              "description":  "Labels stamped on every metric and log line of the run.",
              "map":  {
                "maxEntries":  "32",
                "valueField":  {
                  "name":  "value",
                  "string":  {
                    "maxLen":  "255"
                  }
                }
              },
              "title":  "Labels"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Observability",
      "title":  "Observability"
    },
    {
      "name":  "keep",
      "description":  "Keep machines alive after the run for this long; 0 tears everything down at once.",
      "duration":  {
        "default":  "0s",
        "gte":  "0s",
        "lte":  "2592000s"
      },
      "group":  "Lifecycle",
      "title":  "Keep the stand"
    },
    {
      "name":  "result_expectations",
      "description":  "Metric keys the run must report; a missing key degrades the result.",
      "list":  {
        "items":  [
          {
            "string":  {
              "maxLen":  "64",
              "pattern":  "^[a-z][a-z0-9_]*$"
            }
          }
        ],
        "maxItems":  "64",
        "unique":  true
      },
      "group":  "Lifecycle",
      "title":  "Expected metrics"
    }
  ],
  "rules":  [
    {
      "expr":  "!(\"managed_ydb\" in root) || \"ydb_iam_credentials_secret\" in root.workload",
      "message":  "managed YDB requires named IAM credentials",
      "id":  "managed-ydb-iam"
    },
    {
      "expr":  "!(\"managed_ydb\" in root) || root.managed_ydb.type != \"dedicated\" || [\"zones\", \"resource_preset_id\", \"node_count\", \"storage_groups\", \"storage_type\"].all(k, k in root.managed_ydb)",
      "message":  "dedicated YDB requires placement, compute and storage fields",
      "id":  "managed-ydb-dedicated"
    },
    {
      "expr":  "!(\"managed_ydb\" in root) || root.managed_ydb.type != \"serverless\" || \"storage_size_limit_gb\" in root.managed_ydb",
      "message":  "serverless YDB requires a storage limit",
      "id":  "managed-ydb-serverless"
    },
    {
      "expr":  "!(\"managed_ydb\" in root) || (root.provider.kind == \"yandex\" && root.workload.driver_type == \"ydb\")",
      "message":  "managed YDB requires YC and the YDB driver",
      "id":  "managed-ydb-provider"
    },
    {
      "expr":  "!(\"ydb_iam_credentials_secret\" in root.workload) || root.workload.driver_type == \"ydb\"",
      "message":  "IAM credentials only apply to YDB",
      "id":  "ydb-iam-driver"
    },
    {
      "expr":  "!(\"machines\" in root) || root.machines.all(m, root.machines.filter(x, x.name == m.name).size() == 1)",
      "message":  "machine names must be unique",
      "id":  "machine-names-unique"
    },
    {
      "expr":  "!(\"containers\" in root) || root.containers.all(c, root.containers.filter(x, x.name == c.name).size() == 1)",
      "message":  "container names must be unique",
      "id":  "container-names-unique"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"containers\" in root) || root.containers.all(c, c.machine in root.machines.map(m, m.name))",
      "message":  "every container must land on a declared machine",
      "id":  "container-machine-exists"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"flows\" in root) || root.flows.all(f, f.from_role in root.machines.map(m, m.role))",
      "message":  "flow from_role must be a role of a declared machine",
      "id":  "flow-from-role-exists"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"flows\" in root) || root.flows.all(f, !(\"to_role\" in f) || f.to_role in root.machines.map(m, m.role))",
      "message":  "flow to_role must be a role of a declared machine",
      "id":  "flow-to-role-exists"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"scrapes\" in root) || root.scrapes.all(s, s.role in root.machines.map(m, m.role))",
      "message":  "scrape role must be a role of a declared machine",
      "id":  "scrape-role-exists"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"host_prep\" in root) || root.host_prep.all(h, h.role in root.machines.map(m, m.role))",
      "message":  "host_prep role must be a role of a declared machine",
      "id":  "host-prep-role-exists"
    },
    {
      "expr":  "!(\"machines\" in root) || !(\"workload\" in root) || root.workload.runner_role in root.machines.map(m, m.role)",
      "message":  "the workload runner role must be a role of a declared machine",
      "id":  "runner-role-exists"
    }
  ],
  "strict":  true,
  "coerce":  true
}
