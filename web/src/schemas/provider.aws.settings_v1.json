      "description": "AWS commercial region the run is created in; opt-in regions must be enabled on the account.",
      "group": "Placement",
      "name": "region",
      "required": true,
      "title": "Region"
    },
    {
      "description": "Availability zone inside the region; empty lets AWS pick one.",
      "examples": [
        {
          "stringValue": "eu-central-1a"
        }
      ],
      "group": "Placement",
      "name": "availability_zone",
      "string": {
        "maxLen": "24",
        "pattern": "^[a-z]{2}(-[a-z]+)+-\\d[a-z]$"
      },
      "title": "Availability zone"
    },
    {
      "description": "Create a throwaway VPC for every run, or place runs into an existing one.",
      "group": "Network",
      "name": "network",
      "oneOf": {
        "discriminator": "kind",
        "variants": {
          "create": {
            "fields": [
              {
                "description": "IPv4 range of the VPC created for the run.",
                "name": "cidr",
                "string": {
                  "default": "10.130.0.0/16",
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
                },
                "title": "VPC CIDR"
              }
            ]
          },
          "existing": {
            "fields": [
              {
                "description": "Existing VPC the machines join.",
                "name": "vpc_id",
                "required": true,
                "string": {
                  "pattern": "^vpc-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title": "VPC id"
              },
              {
                "description": "Existing subnet in the chosen availability zone.",
                "name": "subnet_id",
                "required": true,
                "string": {
                  "pattern": "^subnet-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title": "Subnet id"
              },
              {
                "description": "Existing security group applied to every machine.",
                "name": "security_group_id",
                "string": {
                  "pattern": "^sg-[0-9a-f]{8}([0-9a-f]{9})?$"
                },
                "title": "Security group id"
              }
            ]
          }
        }
      },
      "required": true,
      "title": "Network"
    },
    {
      "choice": {
        "default": {
          "stringValue": "m7i"
        },
        "options": [
          {
            "label": "m6i — general purpose, Ice Lake",
            "value": {
              "stringValue": "m6i"
            }
          },
          {
            "label": "m7i — general purpose, Sapphire Rapids",
            "value": {
              "stringValue": "m7i"
            }
          },
          {
            "label": "m6a — general purpose, AMD Milan",
            "value": {
              "stringValue": "m6a"
            }
          },
          {
            "label": "m7a — general purpose, AMD Genoa",
            "value": {
              "stringValue": "m7a"
            }
          },
          {
            "label": "c6i — compute optimized, Ice Lake",
            "value": {
              "stringValue": "c6i"
            }
          },
          {
            "label": "c7i — compute optimized, Sapphire Rapids",
            "value": {
              "stringValue": "c7i"
            }
          },
          {
            "label": "r6i — memory optimized, Ice Lake",
            "value": {
              "stringValue": "r6i"
            }
          },
          {
            "label": "r7i — memory optimized, Sapphire Rapids",
            "value": {
              "stringValue": "r7i"
            }
          }
        ]
      },
      "description": "EC2 family the size table resolves instance types in.",
      "group": "Placement",
      "name": "instance_family",
      "title": "Instance family"
    },
    {
      "choice": {
        "default": {
          "stringValue": "ubuntu-24.04"
        },
        "options": [
          {
            "label": "Ubuntu 24.04 LTS (noble)",
            "value": {
              "stringValue": "ubuntu-24.04"
            }
          },
          {
            "label": "Ubuntu 22.04 LTS (jammy)",
            "value": {
              "stringValue": "ubuntu-22.04"
            }
          },
          {
            "label": "Amazon Linux 2023",
            "value": {
              "stringValue": "al2023"
            }
          }
        ]
      },
      "description": "Boot image family; the concrete AMI id is resolved per region at launch.",
      "group": "Placement",
      "name": "ami_family",
      "title": "AMI family"
    },
    {
      "bool": {
        "default": true
      },
      "description": "Give every machine a public IPv4 address.",
      "group": "Network",
      "name": "public_ips",
      "title": "Public IPs"
    },
    {
      "bool": {
        "default": false
      },
      "description": "Use Spot capacity: much cheaper, but interruptible with a two-minute notice — do not use for a measurement that must complete.",
      "group": "Placement",
      "name": "spot",
      "title": "Spot instances"
    }
  ],
  "id": {
    "name": "aws.settings",
    "namespace": "provider",
    "version": "v1.0.0"
  },
  "rules": [
    {
      "expr": "[this == null ? root : this].all(s, !(\"network\" in s) || s.network.kind == \"create\")",
      "id": "network-create-only",
      "message": "existing networks are not implemented by the pipeline; use a run-owned network"
    }
  ],
  "strict": true
}
