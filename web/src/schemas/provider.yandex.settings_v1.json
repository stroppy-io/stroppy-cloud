{
  "coerce": true,
  "description": "Yandex Cloud placement settings of a tenant provider profile (no secrets).",
  "fields": [
    {
      "description": "Yandex Cloud cloud id owning the folder.",
      "examples": [
        {
          "stringValue": "b1glku4lgd6gabcdefgh"
        }
      ],
      "group": "Account",
      "name": "cloud_id",
      "required": true,
      "string": {
        "pattern": "^[a-z0-9]{20}$"
      },
      "title": "Cloud id"
    },
    {
      "description": "Folder every VM, disk and network of a run is created in.",
      "examples": [
        {
          "stringValue": "b1gia87mbaomkfvsleds"
        }
      ],
      "group": "Account",
      "name": "folder_id",
      "required": true,
      "string": {
        "pattern": "^[a-z0-9]{20}$"
      },
      "title": "Folder id"
    },
    {
      "choice": {
        "default": {
          "stringValue": "ru-central1-d"
        },
        "options": [
          {
            "label": "ru-central1-a",
            "value": {
              "stringValue": "ru-central1-a"
            }
          },
          {
            "label": "ru-central1-b",
            "value": {
              "stringValue": "ru-central1-b"
            }
          },
          {
            "label": "ru-central1-d (recommended)",
            "value": {
              "stringValue": "ru-central1-d"
            }
          },
          {
            "label": "ru-central1-e",
            "value": {
              "stringValue": "ru-central1-e"
            }
          }
        ]
      },
      "description": "Availability zone of ru-central1 the run is placed in.",
      "group": "Placement",
      "name": "zone",
      "required": true,
      "title": "Zone"
    },
    {
      "description": "Three physical zones for multi-zone topologies. When omitted, use zone and two other catalog zones. Single-zone topologies use zone.",
      "group": "Placement",
      "list": {
        "items": [
          {
            "string": {
              "pattern": "^ru-central1-[abde]$"
            }
          }
        ],
        "maxItems": "3",
        "unique": true
      },
      "name": "zones",
      "rules": [
        {
          "expr": "size(this) == 0 || size(this) == 3",
          "id": "zones-none-or-three",
          "message": "give three zones or none"
        }
      ],
      "title": "Distributed topology zones"
    },
    {
      "choice": {
        "default": {
          "stringValue": "standard-v3"
        },
        "options": [
          {
            "label": "Intel Broadwell (standard-v1)",
            "value": {
              "stringValue": "standard-v1"
            }
          },
          {
            "label": "Intel Cascade Lake (standard-v2)",
            "value": {
              "stringValue": "standard-v2"
            }
          },
          {
            "label": "Intel Ice Lake (standard-v3)",
            "value": {
              "stringValue": "standard-v3"
            }
          },
          {
            "label": "AMD Zen 4 (standard-v4a)",
            "value": {
              "stringValue": "standard-v4a"
            }
          },
          {
            "label": "AMD Zen 3 (amd-v1)",
            "value": {
              "stringValue": "amd-v1"
            }
          },
          {
            "label": "Intel Ice Lake compute-optimized (highfreq-v3)",
            "value": {
              "stringValue": "highfreq-v3"
            }
          },
          {
            "label": "AMD Zen 4 compute-optimized (highfreq-v4a)",
            "value": {
              "stringValue": "highfreq-v4a"
            }
          }
        ]
      },
      "description": "Compute platform (CPU generation) the machines are created on.",
      "group": "Placement",
      "name": "platform_id",
      "title": "Platform"
    },
    {
      "description": "Create one network for the profile, or place runs into an existing one. Every run gets its own subnets and security group in it.",
      "group": "Network",
      "name": "network",
      "oneOf": {
        "discriminator": "kind",
        "variants": {
          "create": {
            "fields": [
              {
                "description": "IPv4 range the run subnets are allocated from, one block per zone sized to its machines.",
                "name": "pool_cidr",
                "string": {
                  "default": "10.128.0.0/16",
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/([89]|1\\d|2[0-4])$"
                },
                "title": "Address pool"
              },
              {
                "deprecated": true,
                "description": "Retired: run subnets come from pool_cidr; a stored value is ignored.",
                "name": "subnet_cidr",
                "string": {},
                "title": "Subnet CIDR",
                "when": "false"
              }
            ]
          },
          "existing": {
            "fields": [
              {
                "description": "Existing VPC network the run subnets are created in.",
                "name": "network_id",
                "required": true,
                "string": {
                  "pattern": "^[a-z0-9]{20}$"
                },
                "title": "Network id"
              },
              {
                "description": "IPv4 range of the network kept free for runs; run subnets are allocated from it and must not overlap other subnets of the network.",
                "name": "pool_cidr",
                "required": true,
                "string": {
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/([89]|1\\d|2[0-4])$"
                },
                "title": "Address pool"
              },
              {
                "description": "Route table with a route out (e.g. 0.0.0.0/0 through a NAT gateway) for machines without public addresses. When empty, such a run creates its own NAT gateway.",
                "name": "route_table_id",
                "string": {
                  "pattern": "^[a-z0-9]{20}$"
                },
                "title": "Route table id"
              }
            ]
          }
        }
      },
      "required": true,
      "title": "Network"
    },
    {
      "bool": {
        "default": true
      },
      "description": "Assign a one-to-one NAT public address to every machine. Without them a created network gets one shared NAT gateway for the profile.",
      "group": "Network",
      "name": "public_ips",
      "title": "Public IPs"
    },
    {
      "choice": {
        "default": {
          "stringValue": "ubuntu-2404-lts"
        },
        "options": [
          {
            "label": "Ubuntu 24.04 LTS",
            "value": {
              "stringValue": "ubuntu-2404-lts"
            }
          },
          {
            "label": "Ubuntu 22.04 LTS",
            "value": {
              "stringValue": "ubuntu-2204-lts"
            }
          },
          {
            "label": "Ubuntu 20.04 LTS",
            "value": {
              "stringValue": "ubuntu-2004-lts"
            }
          },
          {
            "label": "Debian 12",
            "value": {
              "stringValue": "debian-12"
            }
          },
          {
            "label": "CentOS Stream 9",
            "value": {
              "stringValue": "centos-stream-9-oslogin"
            }
          }
        ]
      },
      "description": "Boot image family from the standard-images folder.",
      "group": "Placement",
      "name": "image_family",
      "title": "Image family"
    },
    {
      "bool": {
        "default": false
      },
      "description": "Use preemptible VMs: much cheaper, but stopped after 24h or under pressure — do not use for a measurement that must complete.",
      "group": "Placement",
      "name": "preemptible",
      "title": "Preemptible"
    }
  ],
  "id": {
    "name": "yandex.settings",
    "namespace": "provider",
    "version": "v1.0.0"
  },
  "strict": true
}
