{
  "coerce": true,
  "description": "Platform catalog of stroppy versions, their images, protocols and workload scripts.",
  "fields": [
    {
      "choice": {
        "default": {
          "stringValue": "static"
        },
        "options": [
          {
            "label": "Static (admin-edited)",
            "value": {
              "stringValue": "static"
            }
          },
          {
            "label": "Stroppy release",
            "value": {
              "stringValue": "release"
            }
          },
          {
            "label": "Probed from a binary",
            "value": {
              "stringValue": "probe"
            }
          }
        ]
      },
      "description": "Where the catalog came from: hand-written, read from a stroppy release, or probed.",
      "group": "Catalog",
      "name": "source",
      "title": "Source"
    },
    {
      "description": "Every stroppy build the platform offers.",
      "group": "Catalog",
      "list": {
        "items": [
          {
            "object": {
              "schema": {
                "fields": [
                  {
                    "description": "Stroppy build: a release (6.0.0) or a nightly of one commit (nightly-\u003csha\u003e). 6.0.0 is the minimum.",
                    "name": "version",
                    "required": true,
                    "rules": [
                      {
                        "expr": "!this.matches(\"^[0-5]\\\\.\")",
                        "id": "min-v6",
                        "message": "stroppy releases before 6.0.0 are not supported"
                      }
                    ],
                    "string": {
                      "maxLen": "64",
                      "pattern": "^(\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?|nightly-[0-9a-f]{7,40})$"
                    },
                    "title": "Version"
                  },
                  {
                    "description": "Docker image of that build, e.g. ghcr.io/stroppy-io/stroppy:v6.0.0.62.",
                    "name": "image",
                    "required": true,
                    "string": {
                      "maxLen": "512",
                      "minLen": "1"
                    },
                    "title": "Image"
                  },
                  {
                    "bool": {
                      "default": true
                    },
                    "description": "The build ships `stroppy baseline` (6.0.0+); lets the workload form offer the runner self-check.",
                    "name": "baseline",
                    "title": "Has baseline"
                  },
                  {
                    "bool": {
                      "default": false
                    },
                    "description": "The version a new workload starts with; exactly one version carries it.",
                    "name": "default",
                    "title": "Default"
                  },
                  {
                    "bool": {
                      "default": false
                    },
                    "description": "Still runnable, hidden from the picker for new workloads.",
                    "name": "deprecated",
                    "title": "Deprecated"
                  },
                  {
                    "description": "Database protocols this build has drivers for.",
                    "list": {
                      "items": [
                        {
                          "choice": {
                            "options": [
                              {
                                "label": "PostgreSQL",
                                "value": {
                                  "stringValue": "pg"
                                }
                              },
                              {
                                "label": "MySQL / MariaDB",
                                "value": {
                                  "stringValue": "mysql"
                                }
                              },
                              {
                                "label": "Picodata (pgproto)",
                                "value": {
                                  "stringValue": "picodata"
                                }
                              },
                              {
                                "label": "YDB (grpc)",
                                "value": {
                                  "stringValue": "ydb_grpc"
                                }
                              },
                              {
                                "label": "YDB (grpcs, TLS)",
                                "value": {
                                  "stringValue": "ydb_grpcs"
                                }
                              },
                              {
                                "label": "CockroachDB (pgproto)",
                                "value": {
                                  "stringValue": "cockroach"
                                }
                              },
                              {
                                "label": "Noop (framework ceiling)",
                                "value": {
                                  "stringValue": "noop"
                                }
                              }
                            ]
                          }
                        }
                      ],
                      "maxItems": "16",
                      "minItems": "1",
                      "unique": true
                    },
                    "name": "protocols",
                    "required": true,
                    "title": "Protocols"
                  },
                  {
                    "description": "Workload scripts this build ships.",
                    "list": {
                      "items": [
                        {
                          "object": {
                            "schema": {
                              "fields": [
                                {
                                  "description": "Workload script id as passed to `stroppy run`.",
                                  "examples": [
                                    {
                                      "stringValue": "tpcc/tx"
                                    },
                                    {
                                      "stringValue": "tpch/tx"
                                    }
                                  ],
                                  "name": "id",
                                  "required": true,
                                  "string": {
                                    "maxLen": "128",
                                    "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$"
                                  },
                                  "title": "Script id"
                                },
                                {
                                  "name": "title",
                                  "required": true,
                                  "string": {
                                    "maxLen": "128",
                                    "minLen": "1"
                                  },
                                  "title": "Title"
                                },
                                {
                                  "name": "description",
                                  "string": {
                                    "maxLen": "2048"
                                  },
                                  "title": "Description"
                                },
                                {
                                  "description": "Protocols this script runs on; procs variants are pg/mysql only.",
                                  "list": {
                                    "items": [
                                      {
                                        "choice": {
                                          "options": [
                                            {
                                              "label": "PostgreSQL",
                                              "value": {
                                                "stringValue": "pg"
                                              }
                                            },
                                            {
                                              "label": "MySQL / MariaDB",
                                              "value": {
                                                "stringValue": "mysql"
                                              }
                                            },
                                            {
                                              "label": "Picodata (pgproto)",
                                              "value": {
                                                "stringValue": "picodata"
                                              }
                                            },
                                            {
                                              "label": "YDB (grpc)",
                                              "value": {
                                                "stringValue": "ydb_grpc"
                                              }
                                            },
                                            {
                                              "label": "YDB (grpcs, TLS)",
                                              "value": {
                                                "stringValue": "ydb_grpcs"
                                              }
                                            },
                                            {
                                              "label": "CockroachDB (pgproto)",
                                              "value": {
                                                "stringValue": "cockroach"
                                              }
                                            },
                                            {
                                              "label": "Noop (framework ceiling)",
                                              "value": {
                                                "stringValue": "noop"
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    ],
                                    "maxItems": "16",
                                    "unique": true
                                  },
                                  "name": "protocols",
                                  "title": "Protocols"
                                },
                                {
                                  "description": "Steps the script declares; the segment form filters on them.",
                                  "list": {
                                    "items": [
                                      {
                                        "object": {
                                          "schema": {
                                            "fields": [
                                              {
                                                "name": "id",
                                                "required": true,
                                                "string": {
                                                  "maxLen": "64",
                                                  "pattern": "^[a-z][a-z0-9_]*$"
                                                },
                                                "title": "Step id"
                                              },
                                              {
                                                "name": "title",
                                                "string": {
                                                  "maxLen": "128"
                                                },
                                                "title": "Title"
                                              },
                                              {
                                                "choice": {
                                                  "default": {
                                                    "stringValue": "workload"
                                                  },
                                                  "options": [
                                                    {
                                                      "label": "Bootstrap",
                                                      "value": {
                                                        "stringValue": "bootstrap"
                                                      }
                                                    },
                                                    {
                                                      "label": "Workload",
                                                      "value": {
                                                        "stringValue": "workload"
                                                      }
                                                    },
                                                    {
                                                      "label": "Teardown",
                                                      "value": {
                                                        "stringValue": "teardown"
                                                      }
                                                    }
                                                  ]
                                                },
                                                "description": "Where the step sits in a run: preparing, measuring, cleaning up.",
                                                "name": "phase",
                                                "title": "Phase"
                                              }
                                            ],
                                            "strict": true
                                          }
                                        }
                                      }
                                    ],
                                    "maxItems": "64"
                                  },
                                  "name": "steps",
                                  "required": true,
                                  "title": "Steps"
                                },
                                {
                                  "description": "Typed parameters the script declares, as probed from the build; the segment form is generated from the known ones and passes the rest through extra_params.",
                                  "list": {
                                    "items": [
                                      {
                                        "object": {
                                          "schema": {
                                            "fields": [
                                              {
                                                "description": "Typed parameter flag without dashes (load-workers).",
                                                "name": "name",
                                                "required": true,
                                                "string": {
                                                  "maxLen": "64",
                                                  "pattern": "^[a-z][a-z0-9-]*$"
                                                },
                                                "title": "Flag name"
                                              },
                                              {
                                                "description": "Key of the stroppy-config.json params object (loadWorkers).",
                                                "name": "config",
                                                "required": true,
                                                "string": {
                                                  "maxLen": "64",
                                                  "pattern": "^[a-z][A-Za-z0-9]*$"
                                                },
                                                "title": "Config key"
                                              },
                                              {
                                                "choice": {
                                                  "default": {
                                                    "stringValue": "workload"
                                                  },
                                                  "options": [
                                                    {
                                                      "label": "Scenario (run)",
                                                      "value": {
                                                        "stringValue": "run"
                                                      }
                                                    },
                                                    {
                                                      "label": "Workload",
                                                      "value": {
                                                        "stringValue": "workload"
                                                      }
                                                    }
                                                  ]
                                                },
                                                "name": "scope",
                                                "title": "Scope"
                                              },
                                              {
                                                "choice": {
                                                  "options": [
                                                    {
                                                      "label": "string",
                                                      "value": {
                                                        "stringValue": "string"
                                                      }
                                                    },
                                                    {
                                                      "label": "bool",
                                                      "value": {
                                                        "stringValue": "bool"
                                                      }
                                                    },
                                                    {
                                                      "label": "int",
                                                      "value": {
                                                        "stringValue": "int"
                                                      }
                                                    },
                                                    {
                                                      "label": "int64",
                                                      "value": {
                                                        "stringValue": "int64"
                                                      }
                                                    },
                                                    {
                                                      "label": "float64",
                                                      "value": {
                                                        "stringValue": "float64"
                                                      }
                                                    },
                                                    {
                                                      "label": "duration",
                                                      "value": {
                                                        "stringValue": "duration"
                                                      }
                                                    }
                                                  ]
                                                },
                                                "name": "type",
                                                "required": true,
                                                "title": "Type"
                                              },
                                              {
                                                "name": "description",
                                                "string": {
                                                  "maxLen": "1024"
                                                },
                                                "title": "Description"
                                              },
                                              {
                                                "description": "Declared default as stroppy reports it; null when contextual.",
                                                "json": {},
                                                "name": "default",
                                                "nullable": true,
                                                "title": "Default"
                                              },
                                              {
                                                "name": "default_description",
                                                "string": {
                                                  "maxLen": "256"
                                                },
                                                "title": "Default rule"
                                              },
                                              {
                                                "description": "Legacy environment variable of the parameter.",
                                                "name": "env",
                                                "string": {
                                                  "maxLen": "64",
                                                  "pattern": "^[A-Z][A-Z0-9_]*$"
                                                },
                                                "title": "Env name"
                                              }
                                            ],
                                            "strict": true
                                          }
                                        }
                                      }
                                    ],
                                    "maxItems": "64"
                                  },
                                  "name": "params",
                                  "title": "Parameters"
                                }
                              ],
                              "strict": true
                            }
                          }
                        }
                      ],
                      "maxItems": "128",
                      "minItems": "1"
                    },
                    "name": "scripts",
                    "required": true,
                    "title": "Scripts"
                  }
                ],
                "strict": true
              }
            }
          }
        ],
        "maxItems": "64",
        "minItems": "1"
      },
      "name": "versions",
      "required": true,
      "title": "Versions"
    }
  ],
  "id": {
    "name": "stroppy_catalog",
    "namespace": "system",
    "version": "v1.0.0"
  },
  "rules": [
    {
      "expr": "!(\"versions\" in root) || size(root.versions.filter(v, v.default)) == 1",
      "id": "exactly-one-default",
      "message": "exactly one version must be the default"
    }
  ],
  "strict": true
}
