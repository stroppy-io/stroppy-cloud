{
  "coerce": true,
  "description": "RunResult: headline metrics, per-segment outcome, artifacts and summary of one run.",
  "fields": [
    {
      "description": "Metrics keyed by segment and metric name; up to 256 metrics for each of 64 segments.",
      "group": "Result",
      "map": {
        "maxEntries": "16384",
        "valueSchema": {
          "fields": [
            {
              "description": "Headline value of the metric over the window.",
              "double": {},
              "name": "value",
              "required": true,
              "title": "Value"
            },
            {
              "description": "Unit of the value: tps, ms, ratio…",
              "name": "unit",
              "string": {
                "maxLen": "32"
              },
              "title": "Unit"
            },
            {
              "description": "Lowest sample in the window.",
              "double": {},
              "name": "min",
              "title": "Minimum"
            },
            {
              "description": "Highest sample in the window.",
              "double": {},
              "name": "max",
              "title": "Maximum"
            },
            {
              "description": "Mean over the window.",
              "double": {},
              "name": "avg",
              "title": "Average"
            }
          ],
          "strict": true
        }
      },
      "name": "metrics",
      "title": "Metrics"
    },
    {
      "description": "One entry per workload segment, in execution order.",
      "group": "Result",
      "list": {
        "items": [
          {
            "object": {
              "schema": {
                "fields": [
                  {
                    "description": "Name of the workload segment.",
                    "name": "name",
                    "required": true,
                    "string": {
                      "maxLen": "64",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "title": "Segment"
                  },
                  {
                    "choice": {
                      "options": [
                        {
                          "label": "Completed",
                          "value": {
                            "stringValue": "completed"
                          }
                        },
                        {
                          "label": "Failed",
                          "value": {
                            "stringValue": "failed"
                          }
                        },
                        {
                          "label": "Skipped",
                          "value": {
                            "stringValue": "skipped"
                          }
                        },
                        {
                          "label": "Canceled",
                          "value": {
                            "stringValue": "canceled"
                          }
                        }
                      ]
                    },
                    "description": "How the segment ended.",
                    "name": "status",
                    "required": true,
                    "title": "Status"
                  },
                  {
                    "name": "started_at",
                    "timestamp": {},
                    "title": "Started"
                  },
                  {
                    "name": "finished_at",
                    "timestamp": {},
                    "title": "Finished"
                  },
                  {
                    "description": "Metrics measured over this segment's window only (bench summary counters and histogram statistics).",
                    "map": {
                      "maxEntries": "256",
                      "valueSchema": {
                        "fields": [
                          {
                            "description": "Headline value of the metric over the window.",
                            "double": {},
                            "name": "value",
                            "required": true,
                            "title": "Value"
                          },
                          {
                            "description": "Unit of the value: tps, ms, ratio…",
                            "name": "unit",
                            "string": {
                              "maxLen": "32"
                            },
                            "title": "Unit"
                          },
                          {
                            "description": "Lowest sample in the window.",
                            "double": {},
                            "name": "min",
                            "title": "Minimum"
                          },
                          {
                            "description": "Highest sample in the window.",
                            "double": {},
                            "name": "max",
                            "title": "Maximum"
                          },
                          {
                            "description": "Mean over the window.",
                            "double": {},
                            "name": "avg",
                            "title": "Average"
                          }
                        ],
                        "strict": true
                      }
                    },
                    "name": "metrics",
                    "title": "Metrics"
                  },
                  {
                    "description": "Stroppy's own error accounting; nonfatal errors keep the exit status 0.",
                    "name": "errors",
                    "object": {
                      "schema": {
                        "fields": [
                          {
                            "int64": {
                              "gte": "0"
                            },
                            "name": "terminal_errors",
                            "title": "Terminal errors"
                          },
                          {
                            "int64": {
                              "gte": "0"
                            },
                            "name": "failed_iterations",
                            "title": "Failed iterations"
                          },
                          {
                            "int64": {
                              "gte": "0"
                            },
                            "name": "failed_queries",
                            "title": "Failed queries"
                          },
                          {
                            "int64": {
                              "gte": "0"
                            },
                            "name": "retry_attempts",
                            "title": "Retry attempts"
                          }
                        ],
                        "strict": true
                      }
                    },
                    "title": "Nonfatal errors"
                  },
                  {
                    "description": "Exit status of the stroppy process (0 ok, 130/143 canceled, 1 error).",
                    "int64": {
                      "gte": "-1",
                      "lte": "255"
                    },
                    "name": "exit_code",
                    "title": "Exit code"
                  },
                  {
                    "description": "Machine-readable TPC-C report (tpm_c, per-transaction mix and response times, verdicts) when the workload emits one.",
                    "json": {},
                    "name": "compliance",
                    "title": "TPC-C compliance report"
                  },
                  {
                    "description": "Failure text; set when the status is failed.",
                    "name": "error",
                    "string": {
                      "maxLen": "4096"
                    },
                    "title": "Error"
                  }
                ],
                "rules": [
                  {
                    "expr": "!(\"status\" in this) || this.status != \"failed\" || (\"error\" in this)",
                    "id": "failed-segment-has-error",
                    "message": "a failed segment must carry an error"
                  }
                ],
                "strict": true
              }
            }
          }
        ],
        "maxItems": "64"
      },
      "name": "segments",
      "title": "Segments"
    },
    {
      "description": "Graphene artifact references (artifact/\u003cid\u003e): raw stroppy output, the report.",
      "group": "Result",
      "list": {
        "items": [
          {
            "string": {
              "maxLen": "256",
              "minLen": "1"
            }
          }
        ],
        "maxItems": "129",
        "unique": true
      },
      "name": "artifacts",
      "title": "Artifacts"
    },
    {
      "description": "Runner machine self-check from `stroppy baseline`, when the workload asked for one.",
      "group": "Result",
      "name": "baseline",
      "object": {
        "schema": {
          "fields": [
            {
              "bool": {},
              "description": "No verdict failed; warnings do not clear it.",
              "name": "ok",
              "required": true,
              "title": "OK"
            },
            {
              "description": "Hardware-independent invariants stroppy checked.",
              "list": {
                "items": [
                  {
                    "object": {
                      "schema": {
                        "fields": [
                          {
                            "name": "check",
                            "required": true,
                            "string": {
                              "maxLen": "128"
                            },
                            "title": "Check"
                          },
                          {
                            "choice": {
                              "options": [
                                {
                                  "label": "OK",
                                  "value": {
                                    "stringValue": "ok"
                                  }
                                },
                                {
                                  "label": "Warning",
                                  "value": {
                                    "stringValue": "warn"
                                  }
                                },
                                {
                                  "label": "Failed",
                                  "value": {
                                    "stringValue": "fail"
                                  }
                                }
                              ]
                            },
                            "name": "status",
                            "required": true,
                            "title": "Status"
                          },
                          {
                            "name": "detail",
                            "string": {
                              "maxLen": "1024"
                            },
                            "title": "Detail"
                          }
                        ],
                        "strict": true
                      }
                    }
                  }
                ],
                "maxItems": "64"
              },
              "name": "verdicts",
              "title": "Verdicts"
            },
            {
              "description": "The full baseline JSON report (host, tiers, verdicts).",
              "json": {},
              "name": "report",
              "title": "Report"
            },
            {
              "description": "Why the baseline did not run to completion.",
              "name": "error",
              "string": {
                "maxLen": "4096"
              },
              "title": "Error"
            }
          ],
          "strict": true
        }
      },
      "title": "Baseline"
    },
    {
      "description": "The headline numbers the run list, rating and compare sort on.",
      "group": "Summary",
      "name": "summary",
      "object": {
        "schema": {
          "fields": [
            {
              "description": "Transactions per second over the measured segments.",
              "double": {
                "gte": 0
              },
              "name": "tps",
              "title": "Throughput",
              "unit": "tps"
            },
            {
              "double": {
                "gte": 0
              },
              "name": "latency_p50_ms",
              "title": "Latency p50",
              "unit": "ms"
            },
            {
              "double": {
                "gte": 0
              },
              "name": "latency_p95_ms",
              "title": "Latency p95",
              "unit": "ms"
            },
            {
              "double": {
                "gte": 0
              },
              "name": "latency_p99_ms",
              "title": "Latency p99",
              "unit": "ms"
            },
            {
              "description": "Failed requests across the run.",
              "int64": {
                "gte": "0"
              },
              "name": "errors",
              "title": "Errors"
            },
            {
              "description": "Wall-clock length of the measured part of the run.",
              "duration": {
                "gte": "0s"
              },
              "name": "duration",
              "title": "Duration"
            }
          ],
          "strict": true
        }
      },
      "title": "Summary"
    }
  ],
  "id": {
    "name": "result.run",
    "namespace": "spec",
    "version": "v1.0.0"
  },
  "strict": true
}
