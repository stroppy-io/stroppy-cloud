{
  "coerce": true,
  "description": "Docker registry login for private database images (write-only).",
  "fields": [
    {
      "description": "Registry host as it appears in the image reference, e.g. registry.stroppy.io.",
      "examples": [
        {
          "stringValue": "registry.stroppy.io"
        },
        {
          "stringValue": "ghcr.io"
        }
      ],
      "group": "Registry",
      "name": "registry",
      "required": true,
      "string": {
        "maxLen": "255",
        "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:\\d{1,5})?$"
      },
      "title": "Registry"
    },
    {
      "description": "Registry user; for a token-only registry use the vendor's placeholder user.",
      "group": "Registry",
      "name": "username",
      "required": true,
      "string": {
        "maxLen": "128",
        "minLen": "1"
      },
      "title": "Username"
    },
    {
      "description": "Registry password or access token.",
      "group": "Registry",
      "name": "password",
      "required": true,
      "secret": true,
      "string": {
        "maxLen": "4096",
        "minLen": "1"
      },
      "title": "Password / token"
    }
  ],
  "id": {
    "name": "registry.credentials",
    "namespace": "provider",
    "version": "v1.0.0"
  },
  "strict": true
}
