{
  "coerce": true,
  "description": "node_exporter 1.8/1.9 flags: which collectors run and where it listens.",
  "fields": [
    {
      "description": "--web.listen-address port. 9100 is the registered node_exporter port.",
      "group": "Server",
      "int64": {
        "default": "9100",
        "gte": "1",
        "lte": "65535"
      },
      "name": "listen_port",
      "title": "Listen port"
    },
    {
      "description": "Interface part of --web.listen-address; empty means all interfaces.",
      "group": "Server",
      "name": "listen_address",
      "string": {
        "default": "",
        "maxLen": "64"
      },
      "title": "Listen address"
    },
    {
      "bool": {
        "default": false
      },
      "description": "--collector.disable-defaults: start from nothing, only `enable` runs. Off keeps the upstream default set and applies enable/disable on top.",
      "group": "Collectors",
      "name": "disable_defaults",
      "title": "Disable default collectors"
    },
    {
      "description": "--collector.\u003cname\u003e for each. pressure (PSI) and systemd are off upstream and worth turning on for a benchmark host.",
      "group": "Collectors",
      "list": {
        "items": [
          {
            "string": {
              "in": [
                "arp",
                "conntrack",
                "cpu",
                "cpufreq",
                "diskstats",
                "edac",
                "entropy",
                "filefd",
                "filesystem",
                "hwmon",
                "infiniband",
                "ipvs",
                "loadavg",
                "mdadm",
                "meminfo",
                "netclass",
                "netdev",
                "netstat",
                "nfs",
                "nfsd",
                "os",
                "powersupplyclass",
                "pressure",
                "processes",
                "rapl",
                "schedstat",
                "sockstat",
                "softnet",
                "stat",
                "systemd",
                "tapestats",
                "textfile",
                "thermal_zone",
                "time",
                "timex",
                "udp_queues",
                "uname",
                "vmstat",
                "xfs",
                "zfs"
              ]
            }
          }
        ],
        "maxItems": "48",
        "unique": true
      },
      "name": "enable",
      "title": "Enable collectors"
    },
    {
      "description": "--no-collector.\u003cname\u003e for each. Turning off the noisy default collectors keeps the scrape cheap on a loaded host.",
      "group": "Collectors",
      "list": {
        "items": [
          {
            "string": {
              "in": [
                "arp",
                "bcache",
                "bonding",
                "btrfs",
                "conntrack",
                "cpu",
                "cpufreq",
                "diskstats",
                "dmi",
                "edac",
                "entropy",
                "fibrechannel",
                "filefd",
                "filesystem",
                "hwmon",
                "infiniband",
                "ipvs",
                "loadavg",
                "mdadm",
                "meminfo",
                "netclass",
                "netdev",
                "netstat",
                "nfs",
                "nfsd",
                "nvme",
                "os",
                "powersupplyclass",
                "pressure",
                "rapl",
                "schedstat",
                "selinux",
                "sockstat",
                "softnet",
                "stat",
                "tapestats",
                "textfile",
                "thermal_zone",
                "time",
                "timex",
                "udp_queues",
                "uname",
                "vmstat",
                "xfs",
                "zfs",
                "zoneinfo"
              ]
            }
          }
        ],
        "maxItems": "48",
        "unique": true
      },
      "name": "disable",
      "title": "Disable collectors"
    },
    {
      "description": "--collector.filesystem.mount-points-exclude: regex of mount points not to report.",
      "group": "Filters",
      "name": "filesystem_mount_points_exclude",
      "string": {
        "default": "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)",
        "maxLen": "1024"
      },
      "title": "Exclude mount points"
    },
    {
      "description": "--collector.netdev.device-exclude: regex of interfaces not to report.",
      "group": "Filters",
      "name": "netdev_device_exclude",
      "string": {
        "default": "^(veth.*|docker[0-9]+|br-.*|lo)$",
        "maxLen": "1024"
      },
      "title": "Exclude network devices"
    },
    {
      "description": "--collector.diskstats.device-exclude: regex of block devices not to report.",
      "group": "Filters",
      "name": "diskstats_device_exclude",
      "string": {
        "default": "^(ram|loop|fd|(h|s|v|xv)d[a-z]|nvme\\d+n\\d+p)\\d+$",
        "maxLen": "1024"
      },
      "title": "Exclude block devices"
    },
    {
      "description": "--collector.textfile.directory: directory of *.prom files the agent may drop for run-scoped labels.",
      "group": "Filters",
      "name": "textfile_directory",
      "string": {
        "default": "",
        "maxLen": "256"
      },
      "title": "Textfile directory"
    },
    {
      "choice": {
        "default": {
          "stringValue": "warn"
        },
        "options": [
          {
            "label": "debug",
            "value": {
              "stringValue": "debug"
            }
          },
          {
            "label": "info",
            "value": {
              "stringValue": "info"
            }
          },
          {
            "label": "warn",
            "value": {
              "stringValue": "warn"
            }
          },
          {
            "label": "error",
            "value": {
              "stringValue": "error"
            }
          }
        ]
      },
      "description": "--log.level.",
      "group": "Logging",
      "name": "log_level",
      "title": "Log level"
    },
    {
      "choice": {
        "default": {
          "stringValue": "logfmt"
        },
        "options": [
          {
            "label": "logfmt",
            "value": {
              "stringValue": "logfmt"
            }
          },
          {
            "label": "json",
            "value": {
              "stringValue": "json"
            }
          }
        ]
      },
      "description": "--log.format.",
      "group": "Logging",
      "name": "log_format",
      "title": "Log format"
    },
    {
      "computed": {
        "expr": "(\"enable\" in root) ? root.enable.map(c, \" --collector.\" + c).join(\"\") : \"\"",
        "result": "RESULT_TYPE_STRING"
      },
      "group": "Collectors",
      "name": "enable_flags",
      "title": "Rendered --collector.* flags"
    },
    {
      "computed": {
        "expr": "(\"disable\" in root) ? root.disable.map(c, \" --no-collector.\" + c).join(\"\") : \"\"",
        "result": "RESULT_TYPE_STRING"
      },
      "group": "Collectors",
      "name": "disable_flags",
      "title": "Rendered --no-collector.* flags"
    },
    {
      "computed": {
        "expr": "root.disable_defaults ? \" --collector.disable-defaults\" : \"\"",
        "result": "RESULT_TYPE_STRING"
      },
      "group": "Collectors",
      "name": "defaults_flag",
      "title": "Rendered --collector.disable-defaults"
    },
    {
      "computed": {
        "expr": "root.textfile_directory == \"\" ? \"\" : \" --collector.textfile.directory=\" + root.textfile_directory",
        "result": "RESULT_TYPE_STRING"
      },
      "group": "Filters",
      "name": "textfile_flag",
      "title": "Rendered --collector.textfile.directory"
    }
  ],
  "id": {
    "name": "exporter.node",
    "namespace": "cfg",
    "version": "v1.0.0"
  },
  "rules": [
    {
      "expr": "!(\"enable\" in root) || !(\"disable\" in root) || root.enable.all(c, !(c in root.disable))",
      "id": "enable-disable-disjoint",
      "message": "a collector cannot be both enabled and disabled"
    }
  ],
  "strict": true,
  "templates": {
    "conf": "--web.listen-address={{{values.listen_address}}}:{{{values.listen_port}}}{{{values.defaults_flag}}}{{{values.enable_flags}}}{{{values.disable_flags}}} --collector.filesystem.mount-points-exclude={{{values.filesystem_mount_points_exclude}}} --collector.netdev.device-exclude={{{values.netdev_device_exclude}}} --collector.diskstats.device-exclude={{{values.diskstats_device_exclude}}}{{{values.textfile_flag}}} --log.level={{{values.log_level}}} --log.format={{{values.log_format}}}\n"
  }
}
