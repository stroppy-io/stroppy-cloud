# stroppy-cloud server. Every setting is STROPPY_<section>_<key>; the server
# also reads a local .env (this file copied) under the real environment.
STROPPY_HTTP_ADDR=:8080
STROPPY_HTTP_PUBLIC_URL=http://localhost:8080
# Vite dev server; empty in production (same origin).
STROPPY_HTTP_CORS_ORIGINS=http://localhost:5173

STROPPY_LOG_LEVEL=info
STROPPY_LOG_FORMAT=console

STROPPY_INFRA_POSTGRES_HOST=localhost
STROPPY_INFRA_POSTGRES_PORT=5432
STROPPY_INFRA_POSTGRES_USER=stroppy
STROPPY_INFRA_POSTGRES_PASSWORD=stroppy
STROPPY_INFRA_POSTGRES_DATABASE=stroppy

# Graphene door + the service-account token (rolebinding namespace "*").
STROPPY_INFRA_GRAPHENE_ADDRESS=graphene.stroppy.io:443
STROPPY_INFRA_GRAPHENE_TOKEN=
STROPPY_INFRA_GRAPHENE_INSECURE=false

# Dev mode: static bearer tokens instead of Kratos (token=email[=Name],
# comma-separated). Any entry turns Kratos off — local installations only.
# STROPPY_DEV_USERS=dev=dev@stroppy.local=Developer
# Identity: Ory Kratos (deployments/kratos/). JWT verification is local:
# the public half of the signing key set, next to the issuer/audience the
# tokenizer template stamps into every token.
STROPPY_AUTH_JWKS_FILE=deployments/kratos/jwks/kratos-public-jwks.json
# STROPPY_AUTH_JWKS_URL=https://iam.stroppy.io/.well-known/jwks.json
STROPPY_AUTH_ISSUER=stroppy-cloud
STROPPY_AUTH_AUDIENCE=stroppy-cloud
# Kratos public origin as the browser sees it (served to the SPA).
STROPPY_AUTH_KRATOS_PUBLIC_URL=http://localhost:4433

# Bootstrap platform admins (comma-separated verified Kratos e-mails).
STROPPY_ADMIN_EMAILS=

# Pipeline binaries shipped with the server; pushed into every tenant namespace at start.
STROPPY_INFRA_PIPELINES_DIR=/opt/stroppy/pipelines
STROPPY_INFRA_PIPELINES_INTERVAL=10m

# Telemetry stores of the installation (empty = logs/metrics unavailable in the API).
