<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>No account with this address</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6">
  <tr><td align="center" style="padding:32px 16px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;font-family:Inter,-apple-system,'Segoe UI',Roboto,sans-serif;color:#15171c;font-size:15px;line-height:1.5">
      <tr><td style="padding:0 0 16px;font-size:17px;font-weight:700;letter-spacing:-0.01em">
        <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#f16a39;margin-right:8px;vertical-align:middle"></span><a href="https://stroppy.io" style="color:#15171c;text-decoration:none;vertical-align:middle">Stroppy Cloud</a>
      </td></tr>
      <tr><td style="background:#ffffff;border:1px solid #d9dde3;border-radius:8px;padding:32px">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <tr><td style="padding:0 0 12px;font-size:22px;font-weight:700;letter-spacing:-0.01em">No account with this address</td></tr>
          <tr><td style="padding:0 0 16px;color:#15171c">Someone asked to reset a Stroppy Cloud password for this address, but no account uses it.</td></tr>
          <tr><td style="color:#5a6270;font-size:13px">If it was you, you may have signed up with another address or with GitHub. Otherwise ignore this mail.</td></tr>
        </table>
      </td></tr>
      <tr><td style="padding:16px 4px 0;color:#5a6270;font-size:12px">
        You get this because the address was entered on <a href="https://cloud.stroppy.io" style="color:#5a6270">cloud.stroppy.io</a>. Stroppy Cloud &middot; <a href="https://stroppy.io" style="color:#5a6270">stroppy.io</a>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
